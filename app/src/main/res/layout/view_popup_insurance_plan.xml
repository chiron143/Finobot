<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="center"
            android:text="You are currently under-insured"
            android:textColor="@color/colorPrimary" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/inner_progress"
                layout="@layout/progressbar" />
            <TextView
                android:id="@+id/empty_value_insplan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="No data to retrieve"
                android:visibility="gone"
                android:textColor="@color/d_gray"
                android:textSize="@dimen/month_label_size"
                android:layout_gravity="center_horizontal"
                android:layout_centerInParent="true"
                android:gravity="center"/>

        </FrameLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>