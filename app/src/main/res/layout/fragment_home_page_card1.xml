<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">


       <androidx.cardview.widget.CardView
            android:id="@+id/card_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            android:layout_margin="@dimen/margin_medium"
            app:cardCornerRadius="5dp"
            app:cardElevation="5dp"
            app:cardUseCompatPadding="true">
          <!-- app:cardCornerRadius="5dp"
           app:cardElevation="5dp"
           app:cardUseCompatPadding="true"-->

     <LinearLayout
            android:id="@+id/layout_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/layout_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/details_image_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    app:srcCompat="@drawable/ic_welcome_mr"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/details_image_logo"
                    android:layout_marginTop="@dimen/margin_xlarge"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginLeft="@dimen/margin_medium"
                    android:layout_marginRight="@dimen/margin_medium"
                    android:textStyle="bold"
                    android:text="Prompts"
                    tools:text="Welcome"/>
            </LinearLayout>
            <View
                android:id="@+id/view_separator_id"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/AntiqueWhite" />
            <LinearLayout
                android:id="@+id/layout_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left|center"
                    android:textStyle="italic"
                    android:layout_margin="@dimen/margin_medium"
                    android:textColor="@android:color/background_dark"
                    android:text="Hi" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textMessage"
                    android:layout_below="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left|center"
                    android:textStyle="italic"
                    android:layout_margin="@dimen/margin_medium"
                    android:textColor="@android:color/background_dark"
                    android:text="Have a Nice day" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:visibility="invisible"
                android:id="@+id/more_info_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/desc_id"
                android:layout_alignParentRight="true"
                android:layout_gravity="right"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginBottom="@dimen/margin_medium"
                android:layout_marginRight="@dimen/margin_xlarge"
                app:srcCompat="@drawable/ic_menu_dot"
                tools:ignore="ContentDescription,RtlHardcoded" />
        </LinearLayout>







