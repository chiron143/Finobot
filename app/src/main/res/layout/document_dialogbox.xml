<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:rsb="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:gravity="right"
        android:layout_above="@+id/bottom_bar">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom">

        <RelativeLayout
            android:id="@+id/demo1"
            android:layout_width="wrap_content"
            android:layout_gravity="right"
            android:layout_marginRight="@dimen/margin_right"
            android:layout_marginBottom="10dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/demotext1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo1"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:textColor="@color/white"
                />

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="@dimen/filter_image"
                android:layout_height="@dimen/filter_image"
                android:gravity="bottom"
                android:layout_toRightOf="@+id/demotext1"
                android:layout_marginLeft="20dp"
                app:srcCompat="@drawable/ic_camera_icon"/>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/demo2"
            android:layout_width="wrap_content"
            android:layout_gravity="right"
            android:layout_marginRight="@dimen/margin_right"
            android:layout_marginBottom="10dp"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/demotext2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo2"
                android:padding="12dp"
                android:textColor="@color/white"
                android:layout_centerVertical="true"/>

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="@dimen/filter_image"
                android:layout_height="@dimen/filter_image"
                android:gravity="bottom"
                android:layout_toRightOf="@+id/demotext2"
                android:layout_marginLeft="20dp"
                app:srcCompat="@drawable/ic_camera_icon"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/demo3"
            android:layout_width="wrap_content"
            android:layout_gravity="right"
            android:layout_marginRight="@dimen/margin_right"
            android:layout_marginBottom="10dp"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/demotext3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo3"
                android:padding="12dp"
                android:textColor="@color/white"
                android:layout_centerVertical="true"/>

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="@dimen/filter_image"
                android:layout_height="@dimen/filter_image"
                android:gravity="bottom"
                android:layout_toRightOf="@+id/demotext3"
                android:layout_marginLeft="20dp"
                app:srcCompat="@drawable/ic_camera_icon"/>
        </RelativeLayout>





        <RelativeLayout
            android:id="@+id/cross"
            android:layout_width="wrap_content"
            android:layout_gravity="right"
            android:layout_marginRight="@dimen/margin_right"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/txt_cross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                android:text="Demo3"
                android:padding="12dp"
                android:textColor="@color/white"
                android:layout_centerVertical="true"/>

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="@dimen/filter_image"
                android:layout_height="@dimen/filter_image"
                android:gravity="bottom"
                android:layout_toRightOf="@+id/txt_cross"
                android:layout_marginLeft="20dp"
                app:srcCompat="@drawable/ic_upload_icon"/>
        </RelativeLayout>
    </LinearLayout>

    </RelativeLayout>



    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_alignParentBottom="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>


</RelativeLayout>