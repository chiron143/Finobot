<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_height="match_parent">

       <android.widget.Space
           android:layout_width="match_parent"
           android:layout_height="@dimen/margin_large" />
    <LinearLayout
        android:id="@+id/linearrequired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:orientation="vertical">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/signuppasswordtilEditText"
            style="@style/StyledTilPaddedEditTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/margin_xlarge"
            android:layout_marginRight="@dimen/margin_xlarge"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">
            <EditText
                android:id="@+id/expected_inc_age"
                android:layout_width="match_parent"
                android:padding="15dp"
                android:hint="Required till what age"
                android:inputType="number"
                android:maxLength="3"
                android:layout_margin="@dimen/margin_medium"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/StyledTilPaddedEditTextLayout"
            android:layout_below="@+id/signuppasswordtilEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_xlarge"
            android:layout_gravity="center"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">
            <EditText
                android:id="@+id/expected_inc_percentage"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_marginRight="@dimen/margin_xlarge"
                android:padding="15dp"
                android:inputType="number"
                android:drawableRight="@drawable/ic_percentage"
                android:hint="Expected increment in %"
                android:layout_margin="@dimen/margin_medium"
                android:gravity="left"
                android:maxLength="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large"
            android:visibility="gone"
            android:text="Notes"/>

        <EditText
            android:id="@+id/expected_inc_notes"
            android:layout_margin="@dimen/margin_large"
            android:background="@drawable/edt_txt_bg_rectangle"
            android:padding="@dimen/margin_medium"
            android:lines="3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"
        android:orientation="horizontal"
        android:layout_margin="@dimen/margin_medium"
        android:weightSum="2">

        <Button
            android:id="@+id/expected_inc_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button_yesorno"
            android:text="@string/cancel"
            android:textColor="@drawable/button_text_color"
            android:layout_marginRight="@dimen/margin_small" />

        <Button
            android:id="@+id/expected_inc_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button_yesorno"
            android:text="@string/text_forgot_save"
            android:textColor="@drawable/button_text_color"
            />

    </LinearLayout>

    </LinearLayout>


