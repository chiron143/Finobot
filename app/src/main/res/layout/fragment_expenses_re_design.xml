<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.purplepath.purplepath.expensesRedesign.ExpensesReDesignFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

    <RelativeLayout
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/plus_header_height">

    <TextView
        android:id="@+id/exp_header_txtView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:layout_marginLeft="@dimen/margin_xlarge"
        android:text="@string/hello_blank_fragment" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/margin_medium"
            android:layout_toRightOf="@+id/exp_header_txtView"
            android:src="@drawable/ic_edit_icon"/>
    </RelativeLayout>

    <ImageView
        android:id="@+id/header_plus_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_gravity="right"
        android:layout_margin="@dimen/margin_medium"
        android:layout_marginLeft="@dimen/margin_medium"
        android:layout_toRightOf="@+id/exp_header_txtView"
        android:src="@drawable/add_top_icon"/>

</FrameLayout>

    <RelativeLayout
        android:id="@+id/add_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <include layout="@layout/fragment_asset_view" />

    </RelativeLayout>
    <android.support.design.widget.FloatingActionButton
        android:id="@+id/add_floating_button_Id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginTop="@dimen/fab_margin"
        android:layout_marginRight="@dimen/fab_margin"
        android:layout_marginLeft="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:elevation="@dimen/margin_very_small"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_pls_icon"
        android:visibility="visible"
        android:layout_above="@+id/bottom_bar"
        />
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <include layout="@layout/fragment_bottom_bar_view"/>

    </LinearLayout>

</RelativeLayout>
