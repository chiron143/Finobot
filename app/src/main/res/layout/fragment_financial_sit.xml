<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_RelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <android.support.v7.widget.CardView
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="5dp"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <com.purplepath.purplepath.customview.CustomTextView
        android:id="@+id/tv_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:text="Overview"
        android:textAppearance="?android:textAppearanceLarge" />


    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/iv_assets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/iv_center_image"
        android:layout_gravity="center"
        android:layout_toLeftOf="@+id/iv_center_image"
        android:scaleX="1"
        android:scaleY="1"
        app:srcCompat="@drawable/ic_assets_home_page" />

    <com.purplepath.purplepath.customview.CustomTextView
        android:id="@+id/tv_liabilities"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_liabilities"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:layout_marginLeft="@dimen/margin_large"
        android:layout_toRightOf="@+id/iv_center_image"
        android:gravity="right"
        android:text="Liabilities"
        android:textAppearance="?android:textAppearanceSmall" />

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/iv_income_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_center_image"
        android:layout_toLeftOf="@+id/iv_center_image"
        android:scaleX="1"
        android:scaleY="1"
        app:srcCompat="@drawable/ic_income_home_page" />

    <com.purplepath.purplepath.customview.CustomTextView
        android:id="@+id/tv_income_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_expenseDetails"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:layout_toLeftOf="@+id/iv_center_image"
        android:gravity="right"
        android:maxLines="2"
        android:text="Income "
        android:textAppearance="?android:textAppearanceSmall" />

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/iv_expenseDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_center_image"
        android:layout_toRightOf="@+id/iv_center_image"
        android:scaleX="1"
        android:scaleY="1"
        app:srcCompat="@drawable/ic_expense_details" />

    <com.purplepath.purplepath.customview.CustomTextView
        android:id="@+id/tv_expense_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_expenseDetails"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:layout_toRightOf="@+id/iv_center_image"
        android:gravity="left"
        android:maxLines="2"
        android:text="Expense "
        android:textAppearance="?android:textAppearanceSmall" />

    <LinearLayout
        android:id="@+id/iv_center_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/iv_netWorth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/ic_net_worth_big" />

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/iv_cashManagement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:layout_marginTop="@dimen/margin_very_small"
            app:srcCompat="@drawable/ic_cash_management_big" />
    </LinearLayout>

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/iv_liabilities"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/iv_center_image"
        android:layout_toEndOf="@+id/iv_center_image"
        android:layout_toRightOf="@+id/iv_center_image"
        android:scaleX="1"
        android:scaleY="1"
        app:srcCompat="@drawable/ic_liabilities_home_page" />

    <com.purplepath.purplepath.customview.CustomTextView
        android:id="@+id/tv_assets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:text="Assets"
        android:textAppearance="?android:textAppearanceSmall"
        android:layout_toLeftOf="@+id/iv_center_image"
        android:layout_below="@+id/iv_assets"
        android:layout_marginRight="@dimen/margin_large"
        android:layout_alignBaseline="@+id/tv_liabilities"

       />

    </RelativeLayout>

    </android.support.v7.widget.CardView>
</RelativeLayout>