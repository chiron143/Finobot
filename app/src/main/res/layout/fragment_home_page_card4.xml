<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">


    <androidx.cardview.widget.CardView
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="5dp"
        app:cardElevation="5dp"
        android:layout_margin="@dimen/margin_medium"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:id="@+id/outerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/details_image_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    app:srcCompat="@drawable/ic_learnings_1"
                    />

                <!--app:srcCompat="@drawable/income_detailes"
                tools:src="@drawable/income_detailes"-->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/details_image_logo"
                    android:layout_marginTop="@dimen/margin_xlarge"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginLeft="@dimen/margin_medium"
                    android:layout_marginRight="@dimen/margin_medium"
                    android:text="Quotes"
                    android:textStyle="bold"
                    tools:text="Quotes"
                    />

            </RelativeLayout>

            <View
                android:id="@+id/view_separator_id"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/AntiqueWhite" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:gravity="left|center"
                android:layout_above="@+id/person"
                android:textStyle="italic"
                android:layout_margin="@dimen/margin_medium"
                android:textColor="@android:color/background_dark"
                android:text="Life shrinks or expands in proportion to one’s courage." />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/person"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:gravity="left|center"
                android:layout_above="@+id/more_info_id"
                android:textStyle="italic"
                android:layout_margin="@dimen/margin_medium"
                android:textColor="@android:color/background_dark"
                android:paddingLeft="@dimen/margin_xlarge"
                android:text="-Anais Nin" />


            <androidx.appcompat.widget.AppCompatImageView
                android:visibility="invisible"
                android:id="@+id/more_info_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/desc_id"
                android:layout_alignParentRight="true"
                android:layout_gravity="right"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginBottom="@dimen/margin_medium"
                android:layout_marginRight="@dimen/margin_xlarge"
                app:srcCompat="@drawable/ic_menu_dot"
                tools:ignore="ContentDescription,RtlHardcoded" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>