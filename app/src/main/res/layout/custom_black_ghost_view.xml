<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.purplepath.purplepath.customview.CustomTextInputLayout
        android:id="@+id/currencyhintId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintTextAppearance="@style/StyledTilEditTextLabel"
        android:layout_gravity="center"
        android:textColorHint="@color/dark_gray_text_colour">
        <com.blackcat.currencyedittext.CurrencyEditText
            android:id="@+id/curencyGhostEditTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/amountInWords"
            android:layout_toStartOf="@+id/amountInWords"
            android:layout_centerInParent="true"
            app:allow_negative_values="true"
            android:maxLength="16"
            android:textColorHint="@color/app_text_color_gray"
            app:hintTextAppearance="@style/StyledTilEditTextLabel"
            />
    </com.purplepath.purplepath.customview.CustomTextInputLayout>

    <TextView
        android:id="@+id/hintViewTxtId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/amountInWords"
        android:layout_toLeftOf="@+id/amountInWords"
        android:layout_below="@+id/currencyhintId"
        android:layout_centerInParent="true"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:singleLine="false"
        android:layout_marginRight="@dimen/margin_xlarge"
        android:textColor="@color/hint_color"
        android:gravity="start"
        android:visibility="gone"
        android:textSize="12sp"
        android:text=""
        />

    <TextView
        android:id="@+id/amountInWords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:background="@color/white"
        android:layout_below="@+id/currencyhintId"
        android:layout_centerInParent="true"
        android:layout_marginRight="@dimen/margin_xlarge"
        android:textColor="@color/colorPrimary"
        android:textStyle="italic"
        android:gravity="center"
        android:visibility="visible"
        android:textSize="12sp"
        android:text="0.0"/>
</RelativeLayout>