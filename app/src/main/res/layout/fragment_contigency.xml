<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">



    <android.support.v7.widget.CardView
        android:id="@+id/card_view"
        android:padding="@dimen/margin_large"
        android:elevation="@dimen/margin_small"
        android:background="@color/WhiteSmoke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/iv_center_images"
        android:layout_centerHorizontal="true">




    <com.purplepath.purplepath.customview.CustomTextView
        android:id="@+id/tv_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:visibility="gone"
        android:textAppearance="?android:textAppearanceLarge"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:text="Insurance Planning"
      />





    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_heading"
       >



        <android.support.v7.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleY="1"
            android:scaleX="1"
            app:srcCompat="@drawable/ic_expense_fund"
            android:layout_above="@+id/tv_expense_fund"
            android:layout_centerHorizontal="true"
            android:id="@+id/iv_expenseFund" />
        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/tv_expense_fund"
            android:layout_above="@+id/iv_center_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:textAppearanceSmall"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:layout_centerHorizontal="true"
            android:text="Emergency Fund"/>
        <ImageView
            android:id="@+id/iv_center_image"
            android:layout_margin="@dimen/margin_xlarge"
            android:visibility="invisible"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_goal_planning"/>

        <TextView
            android:id="@+id/center_below_view"
            android:layout_below="@+id/iv_center_image"
            android:layout_width="@dimen/contigency_view"
            android:layout_height="0dp"
            android:layout_centerHorizontal="true"/>

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/lifeInsurance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/iv_center_image"
            android:layout_marginRight="@dimen/margin_medium"
            android:scaleY="1"
            android:scaleX="1"
            app:srcCompat="@drawable/ic_life_insurance"
            android:layout_below="@+id/tv_expense_fund"/>
        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/tv_assets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:textAppearanceSmall"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:layout_below="@+id/lifeInsurance"
            android:layout_toLeftOf="@+id/iv_center_image"
            android:layout_marginRight="@dimen/margin_xlarge"
            android:gravity="center"
            android:text="Life Insurance"/>

        <android.support.v7.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_health_insurance"
            android:layout_marginLeft="@dimen/margin_medium"
            android:layout_toRightOf="@+id/iv_center_image"
            android:id="@+id/iv_health_insurance"
            android:layout_below="@+id/tv_expense_fund"
           />
        <!--android:tint="@color/transparent_black"-->
        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/tv_retirementPlanning"
            android:layout_below="@+id/iv_health_insurance"
            android:layout_toRightOf="@+id/iv_center_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:textAppearanceSmall"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:layout_marginLeft="@dimen/margin_xlarge"
            android:gravity="center"
            android:text="Health Insurance"/>

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/iv_property_insurance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_center_image"
            android:layout_toLeftOf="@+id/center_below_view"
            android:scaleY="1"
            android:scaleX="1"
            app:srcCompat="@drawable/ic_property_insurance"
            />
        <!--android:tint="@color/transparent_black"-->
        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/tv_income_details"
            android:layout_below="@+id/iv_property_insurance"
            android:layout_toLeftOf="@+id/center_below_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:textAppearanceSmall"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:gravity="center_horizontal"
            android:text="Property Insurance"/>

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/iv_automobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_center_image"
            android:scaleY="1"
            android:scaleX="1"
            app:srcCompat="@drawable/autoinsurance"
            android:layout_toRightOf="@+id/center_below_view"
           />
       <!-- android:tint="@color/transparent_black"-->

        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/tv_expense_details"
            android:layout_below="@+id/iv_automobile"
            android:layout_toRightOf="@+id/center_below_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:textAppearanceSmall"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:gravity="center"
            android:text="Motor Insurance"/>


    </RelativeLayout>
    </android.support.v7.widget.CardView>




    <ImageView
        android:id="@+id/iv_center_images"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_goal_planning"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true" />




    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>

    </LinearLayout>

</RelativeLayout>
