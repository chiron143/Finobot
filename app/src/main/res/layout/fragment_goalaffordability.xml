<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <RelativeLayout
            android:layout_above="@+id/bottom_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollview"

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:isScrollContainer="false"
        android:windowFullscreen="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_margin="@dimen/margin_medium"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <LinearLayout
        android:layout_marginLeft="@dimen/margin_large"
        android:layout_marginRight="@dimen/margin_medium"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/goaltype"
            android:text="@string/title_goal_type"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </LinearLayout>



    <Spinner
        android:id="@+id/goaltypespinner"
        style="@style/Widget.AppCompat.Spinner.Underlined"
        android:prompt="@string/select"
        android:layout_margin="@dimen/margin_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <android.support.design.widget.TextInputLayout
        android:id="@+id/goalTimeframe"
        style="@style/StyledTilPaddedEditTextLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:textColorHint="@color/dark_gray_text_colour"
        app:hintTextAppearance="@style/StyledTilEditTextLabel">


        <android.support.v7.widget.AppCompatEditText
            android:id="@+id/goalTimeframe_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Timeframe"
            android:inputType="number"
            android:drawablePadding="@dimen/margin_xlarge"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/dark_gray_text_colour" />
    </android.support.design.widget.TextInputLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

        <!--<android.support.design.widget.TextInputLayout-->
            <!--android:id="@+id/goalcurrentcost"-->
            <!--style="@style/StyledTilPaddedEditTextLayout"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:layout_margin="@dimen/margin_medium"-->
            <!--app:hintTextAppearance="@style/StyledTilEditTextLabel">-->


            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/goalcurrentcostrupee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1.7"
                android:hint="Current cost"
                android:inputType="textCapSentences"
                android:drawablePadding="@dimen/margin_xlarge"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour" />
        <!--</android.support.design.widget.TextInputLayout>-->

            <com.purplepath.purplepath.customview.CustomCalenderImageView
                android:id="@+id/goalcurrentcostrupee_calculaterImgView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.3"
                android:drawablePadding="@dimen/margin_xlarge" />

        </LinearLayout>

        <android.support.design.widget.TextInputLayout
            android:id="@+id/goalExpectedincrease"
            style="@style/StyledTilPaddedEditTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:textColorHint="@color/dark_gray_text_colour"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">


            <com.purplepath.purplepath.customview.PercentageEditText
                android:id="@+id/goalExpectedincreaseEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Expected increment"
                android:inputType="textCapSentences"
                android:drawablePadding="@dimen/margin_xlarge"
                android:maxLength="3"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour" />
        </android.support.design.widget.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
        <!--<android.support.design.widget.TextInputLayout-->
            <!--android:id="@+id/goalanuualsavings"-->
            <!--style="@style/StyledTilPaddedEditTextLayout"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:layout_margin="@dimen/margin_medium"-->
            <!--app:hintTextAppearance="@style/StyledTilEditTextLabel">-->


            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/goalcurrentsavingsEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1.7"
                android:hint="Current Savings"
                android:inputType="textCapSentences"
                android:drawablePadding="@dimen/margin_xlarge"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour" />
       <!-- </android.support.design.widget.TextInputLayout>-->

        <com.purplepath.purplepath.customview.CustomCalenderImageView
            android:id="@+id/goalcurrentsavingsEdit_calculaterImgView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.3"
            android:drawablePadding="@dimen/margin_xlarge" />

    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
        <!--<android.support.design.widget.TextInputLayout
            android:id="@+id/goalcurrentsavings"
            style="@style/StyledTilPaddedEditTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">-->


            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/goalanuualsavingsEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1.7"
                android:hint="Aunnal Savings"
                android:inputType="textCapSentences"
                android:drawablePadding="@dimen/margin_xlarge"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour" />
        <!--</android.support.design.widget.TextInputLayout>-->

        <com.purplepath.purplepath.customview.CustomCalenderImageView
            android:id="@+id/goalanuualsavingsEdit_calculaterImgView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.3"
            android:drawablePadding="@dimen/margin_xlarge" />

    </LinearLayout>



        <android.support.design.widget.TextInputLayout
            android:id="@+id/goalExpectedreturn"
            style="@style/StyledTilPaddedEditTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:textColorHint="@color/dark_gray_text_colour"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">


            <com.purplepath.purplepath.customview.PercentageEditText
                android:id="@+id/goalExpectedreturnEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/margin_xlarge"
                android:hint="Expected Return"
                android:inputType="textCapSentences"
                android:maxLength="3"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour" />
        </android.support.design.widget.TextInputLayout>

    </LinearLayout>
    </LinearLayout>
    </ScrollView>
            </RelativeLayout>



    <android.support.design.widget.FloatingActionButton
        android:id="@+id/goalaff_fab_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="@dimen/fab_margin"
        android:layout_marginRight="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:background="@color/colorPrimary"
        android:layout_above="@+id/bottom_bar_layout"
        android:scaleType="fitXY"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_done_menu"
        android:visibility="visible"/>


    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>


</RelativeLayout>
