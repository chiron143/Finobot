<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    >

    <RelativeLayout
        android:id="@+id/layout_emer"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">


        <TextView
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_margin="8dp"
            android:text="Emergency Fund Requirement"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp" />

        <View
            android:id="@+id/card_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/card_title"
            android:layout_margin="9dp"
            android:background="@color/line_background" />

        <LinearLayout
            android:id="@+id/question_panel_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/card_separator"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/number_of_months"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="Number of months"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/amount_required"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="Amount Required"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/amount_accumulated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="Amount Accumulated"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/amount_difference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="Difference"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/answer_panel_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/card_separator"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@+id/question_panel_id"
            android:layout_toRightOf="@+id/question_panel_id"
            android:orientation="vertical">

            <TextView
                android:id="@+id/answer_number_of_months"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textSize="13sp"
                tools:text="0" />

            <TextView
                android:id="@+id/answer_amount_required"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textSize="13sp"
                tools:text="0" />

            <TextView
                android:id="@+id/answer_amount_accumulated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textSize="13sp"
                tools:text="0" />

            <TextView
                android:id="@+id/answer_amount_difference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textSize="13sp"
                tools:text="0" />
        </LinearLayout>

        <View
            android:id="@+id/card_separator_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/question_panel_id"
            android:layout_margin="9dp"
            android:background="@color/line_background" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/card_separator_2"
            android:layout_centerHorizontal="true"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/footer_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="Your Emergency Fund Status - " />

            <TextView
                android:id="@+id/answer_footer_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_color_filter_blue_transparent"
                android:textSize="13sp"
                tools:text="Shortfall" />

        </LinearLayout>


        <TextView
            android:id="@+id/empty_value_emerplan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No data to retrived"
            android:visibility="gone"
            android:textColor="@color/d_gray"
            android:textSize="@dimen/month_label_size"
            android:layout_gravity="center_horizontal"
            android:layout_centerInParent="true"
            android:gravity="center"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>
</RelativeLayout>