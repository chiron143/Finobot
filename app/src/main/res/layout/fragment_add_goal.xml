<?xml version="1.0" encoding="utf-8"?>
 <androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        tools:context=".activity.LoginandSignUpActivity">

     <LinearLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_bar_view"/>

    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_goal_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/ic_done_menu"
        android:visibility="gone" />

     <RelativeLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:visibility="gone">

         <RelativeLayout
             android:id="@+id/goal_header_bg_relativelayout"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">

             <TextView
                 android:id="@+id/goal_headear_bg_TxtView"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_margin="@dimen/margin_large"
                 android:gravity="center"
                 android:text="Please Add Goal By Clicking the + Button"
                 android:textColor="@color/dark_gray_text_colour"
                 android:textSize="@dimen/day_number_size" />
         </RelativeLayout>

         <FrameLayout
             android:id="@+id/goal_plus_btn_framelayout"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_below="@+id/goal_header_bg_relativelayout"
             android:layout_centerHorizontal="true">
             <!--<ImageView-->
             <!--android:id="@+id/goal_plus_bg_imageView"-->
             <!--android:layout_width="match_parent"-->
             <!--android:layout_height="wrap_content"-->
             <!--android:src="@drawable/goal_plus_bg"/>-->

             <androidx.appcompat.widget.AppCompatImageView
                 android:id="@+id/goal_click_image"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 app:srcCompat="@drawable/ic_add_icon_big" />
         </FrameLayout>

         <ImageView
             android:id="@+id/goal_bottom_bg_imageView"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_alignParentBottom="true"
             android:layout_below="@+id/goal_plus_btn_framelayout"
             android:layout_centerHorizontal="true"
             android:scaleType="fitXY"
             android:src="@drawable/empty_logo" />
     </RelativeLayout>

 </androidx.coordinatorlayout.widget.CoordinatorLayout>
