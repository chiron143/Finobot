                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_margin="@dimen/margin_large"
                            android:maxLines="1"
                            android:visibility="invisible"
                            android:text="0"/>
                    </LinearLayout>


                <LinearLayout
