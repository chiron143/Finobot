<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_RelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">


    <android.support.v7.widget.CardView
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        app:cardCornerRadius="5dp"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="true">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:text="Need of the hour..."
                android:textSize="@dimen/text_size"
                android:textStyle="italic" />

            <LinearLayout
                android:id="@+id/overall_layout_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal"
                android:weightSum="2">


                <android.support.v7.widget.CardView
                    android:id="@+id/card_two"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/WhiteSmoke"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="5dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:id="@+id/already_taxfiling_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/tax_card_color"
                        android:orientation="vertical">

                        <android.support.v7.widget.AppCompatImageView
                            android:id="@+id/tax_filing_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_tax_home_one" />

                        <TextView
                            android:id="@+id/tax_filing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tax_home_image1"
                            android:layout_margin="@dimen/margin_small"
                            android:gravity="center"
                            android:text="Tax Planning"
                            android:textAppearance="?android:textAppearanceLarge"
                            android:textColor="@color/tax_title"
                            android:textSize="@dimen/text_size" />

                        <TextView
                            android:id="@+id/tax_filing_year"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="FY 2019-20"
                            android:textAppearance="?android:textAppearanceLarge"
                            android:textColor="@color/tax_title"
                            android:textSize="@dimen/month_label_size" />

                        <TextView
                            android:id="@+id/get_your_file"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center"
                            android:text="(Do your tax planing here)\n"
                            android:textColor="@color/d_gray"
                            android:textSize="12sp"
                            android:textStyle="italic" />

                        <TextView
                            android:id="@+id/comming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Comming Soon*"
                            android:textColor="@color/reds"
                            android:textSize="@dimen/text_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/tax_filing_click"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="@dimen/margin_large"
                            android:background="@drawable/tax_summary_background"
                            android:orientation="horizontal"

                            android:padding="@dimen/margin_small">

                            <TextView
                                android:id="@+id/txt_proceeds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Proceed"
                                android:textColor="@color/white"
                                android:textStyle="bold" />


                            <android.support.v7.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                app:srcCompat="@drawable/ic_tax_summary_arrow" />

                        </LinearLayout>
                    </LinearLayout>
                </android.support.v7.widget.CardView>

                <android.support.v7.widget.CardView
                    android:id="@+id/card_two_s"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/WhiteSmoke"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="5dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:id="@+id/already_taxfiling_layout_s"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/tax_card_color"
                        android:orientation="vertical">

                        <android.support.v7.widget.AppCompatImageView
                            android:id="@+id/tax_filing_image_s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_tax_home_one" />

                        <TextView
                            android:id="@+id/tax_filing_s"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tax_home_image1"
                            android:layout_margin="@dimen/margin_small"
                            android:gravity="center"
                            android:text="Tax Filing"
                            android:textAppearance="?android:textAppearanceLarge"
                            android:textColor="@color/tax_title"
                            android:textSize="@dimen/text_size" />

                        <TextView
                            android:id="@+id/tax_filing_year_s"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="FY 2018-19"
                            android:textAppearance="?android:textAppearanceLarge"
                            android:textColor="@color/tax_title"
                            android:textSize="@dimen/month_label_size" />

                        <TextView
                            android:id="@+id/get_your_file_s"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center"
                            android:text="(Do your tax filing here)\n"
                            android:textColor="@color/d_gray"
                            android:textSize="12sp"
                            android:textStyle="italic" />

                        <TextView
                            android:id="@+id/comming_s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Coming Soon*"
                            android:textColor="@color/reds"
                            android:textSize="@dimen/text_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/tax_filing_click_s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="@dimen/margin_large"
                            android:background="@drawable/tax_summary_background"
                            android:orientation="horizontal"

                            android:padding="@dimen/margin_small">

                            <TextView
                                android:id="@+id/txt_proceeds_s"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Proceed"
                                android:textColor="@color/white"
                                android:textStyle="bold" />


                            <android.support.v7.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                app:srcCompat="@drawable/ic_tax_summary_arrow" />

                        </LinearLayout>
                    </LinearLayout>
                </android.support.v7.widget.CardView>
            </LinearLayout>

        </RelativeLayout>

    </android.support.v7.widget.CardView>


    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    </FrameLayout>


</RelativeLayout>
