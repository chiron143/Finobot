<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_above="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/empty_values_taxation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No data to retrieve"
            android:visibility="gone"
            android:textColor="@color/d_gray"
            android:textSize="@dimen/month_label_size"
            android:layout_gravity="center_horizontal"
            android:layout_centerInParent="true"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/one"
            android:layout_above="@+id/card_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:text="Your Taxation"
                android:textColor="@color/colorPrimary" />



                <RelativeLayout
                    android:id="@+id/tableParentView_taxation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                </RelativeLayout>







        </LinearLayout>



    </LinearLayout>

    <android.support.v7.widget.CardView
        android:id="@+id/card_view"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_marginBottom="@dimen/margin_large"
        android:padding="@dimen/margin_large"
        android:elevation="@dimen/margin_small"
        android:background="@color/WhiteSmoke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_large"
        android:layout_marginRight="@dimen/margin_large"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/WhiteSmoke">

        <TextView
            android:id="@+id/amount_pay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Based on the input provided"/>

        <TextView
            android:id="@+id/average_tax"
            android:layout_below="@+id/amount_pay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Average Tax Rate"/>
        <TextView
            android:id="@+id/mar_tax"
            android:layout_below="@+id/average_tax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marginal Tax Rate"/>


        <TextView
            android:id="@+id/average_taxs"
            android:layout_below="@+id/mar_tax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Average Tax Rate : is a kind of flat rate to view how much tax was paid overall"/>
        <TextView
            android:id="@+id/mar_taxs"
            android:layout_below="@+id/average_taxs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marginal Tax Rate : is a rate at which to be paid for the next rupee in earnings"/>

        </RelativeLayout>
    </android.support.v7.widget.CardView>


    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>
</RelativeLayout>