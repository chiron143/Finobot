<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.purplepath.purplepath.goal.GoalDetailFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/backButtonId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_back_default_icon"
            android:scaleType="fitCenter"
            android:padding="@dimen/margin_xlarge"
            android:scaleX="0.85"
            android:scaleY="0.85"
            android:adjustViewBounds="true"
            android:layout_marginLeft="@dimen/margin_xlarge"
            android:layout_alignParentLeft="true"/>

        <TextView
            android:id="@+id/dialogTitleId"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/white"/>

    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:background="@color/white"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/goalname_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/goalInputLayout"
                        style="@style/StyledTilPaddedEditTextLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:textColorHint="@color/dark_gray_text_colour"
                        app:hintTextAppearance="@style/StyledTilEditTextLabel">

                        <com.purplepath.purplepath.customview.CharacterEditText
                            android:id="@+id/goal_detail_name_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/margin_xlarge"
                            android:hint="@string/goal_name_txt"
                            android:maxLength="50"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/dark_gray_text_colour"
                            android:textColorHint="@color/dark_gray_text_colour" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/goalcategory_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/margin_medium"
                        android:orientation="horizontal">

                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/customTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/margin_medium"
                            android:text="@string/goal_category_txt"
                            android:textAppearance="?android:attr/textAppearanceSmall" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/goal_category_levelone_spinner"
                        style="@style/Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overlapAnchor="false"
                        android:spinnerMode="dropdown" />


                </LinearLayout>


                <LinearLayout
                    android:id="@+id/goal_category_leveltwo_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/goal_category_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:visibility="invisible" />

                    <Spinner
                        android:id="@+id/goal_category_leveltwo_spinner"
                        style="@style/Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overlapAnchor="false"
                        android:spinnerMode="dropdown" />


                </LinearLayout>


                <LinearLayout
                    android:id="@+id/goal_category_levelthree_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/goal_category_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:visibility="invisible" />

                    <Spinner

                        android:id="@+id/goal_category_levelthree_spinner"
                        style="@style/Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overlapAnchor="false"
                        android:spinnerMode="dropdown" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/other_category_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/StyledTilPaddedEditTextLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:textColorHint="@color/dark_gray_text_colour"
                        app:hintTextAppearance="@style/StyledTilEditTextLabel">

                        <EditText
                            android:id="@+id/goal_othercategory_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/margin_xlarge"
                            android:hint="@string/goal_other_category_txt"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/dark_gray_text_colour"
                            android:textColorHint="@color/dark_gray_text_colour" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>




                <LinearLayout
                    android:id="@+id/goal_family_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:layout_marginRight="@dimen/margin_medium"
                        android:text="@string/goal_belongsto_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />
                    <Spinner
                        android:id="@+id/goal_detail_belongsto_spinner"
                        style="@style/Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_margin="@dimen/margin_medium"
                        android:overlapAnchor="false" />

                </LinearLayout>












                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/margin_medium"
                    android:textColor="@color/dark_gray_text_colour"
                    android:textColorHint="@color/dark_gray_text_colour"
                    android:visibility="gone"
                    android:weightSum="2">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:layout_weight="1"
                        android:text="@string/goal_costtogoal_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/goal_cost_to_goal_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.purplepath.purplepath.customview.CurrencyGhostView
                            android:id="@+id/et_costToGoal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_medium"
                            android:layout_weight="1.7"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/dark_gray_text_colour"
                            android:textColorHint="@color/dark_gray_text_colour" />

                        <com.purplepath.purplepath.customview.CustomCalenderImageView
                            android:id="@+id/calculaterImgView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/margin_medium"
                            android:layout_weight="0.3" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="6">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3.5"
                        android:gravity="center"
                        android:visibility="gone">

                        <SeekBar
                            android:id="@+id/costtogoal_seekbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/margin_medium"
                            android:indeterminate="false"
                            android:max="10000000"
                            android:maxHeight="3dip"
                            android:minHeight="3dip"
                            android:progress="0"
                            android:progressDrawable="@drawable/styled_seekbar_progress"
                            android:thumb="@drawable/seekbar_round" />

                    </RelativeLayout>
                    <!--if seekbar is need the change weight in to 2.5!-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:layout_weight="6"
                        android:background="@drawable/edt_txt_bg_rectangle"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_medium"
                        android:weightSum="5">

                        <ImageButton
                            android:id="@+id/ib_minus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:background="@color/white"
                            android:padding="@dimen/margin_medium"

                            android:src="@drawable/minus" />

                        <com.purplepath.purplepath.customview.CurrencyDefaultEdt
                            android:id="@+id/goal_costtogoal_edt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="number"
                            android:text=""
                            android:textAppearance="?android:attr/textAppearanceSmall"

                            />

                        <ImageButton
                            android:id="@+id/ib_plus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:background="@color/white"
                            android:padding="@dimen/margin_medium"
                            android:src="@drawable/plus" />
                    </LinearLayout>


                </LinearLayout>


                <LinearLayout
                    android:id="@+id/Years_to_Goal_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:weightSum="2">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:layout_weight="1"
                        android:text="@string/goal_yeartogoal_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />


                </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginRight="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:orientation="horizontal"
                        android:weightSum="6">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3.5"
                            android:gravity="center">

                            <SeekBar
                                android:id="@+id/yearstogoal_seekbar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/margin_medium"
                                android:indeterminate="false"
                                android:max="70"
                                android:maxHeight="3dip"
                                android:minHeight="3dip"
                                android:progress="0"
                                android:progressDrawable="@drawable/styled_seekbar_progress"
                                android:thumb="@drawable/seekbar_round" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/margin_medium"
                            android:layout_weight="2.5"
                            android:gravity="center">

                            <EditText
                                android:id="@+id/goal_yearstogoal_edt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/margin_medium"
                                android:background="@drawable/edt_txt_bg_rectangle"
                                android:drawableLeft="@drawable/minus"
                                android:drawablePadding="@dimen/margin_medium"
                                android:drawableRight="@drawable/plus"
                                android:gravity="center"
                                android:inputType="number"
                                android:padding="@dimen/margin_medium"
                                android:textAppearance="?android:attr/textAppearanceSmall" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>







                <LinearLayout
                    android:id="@+id/goal_duration_txt_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="@dimen/margin_medium"
                    android:weightSum="2">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:layout_weight="1"
                        android:text="@string/goal_duration_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />



                <LinearLayout
                    android:id="@+id/goal_duration_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginRight="@dimen/margin_medium"
                    android:orientation="horizontal"
                    android:weightSum="6">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3.5"
                        android:gravity="center">

                        <SeekBar
                            android:id="@+id/goal_duration_seekbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/margin_medium"
                            android:indeterminate="false"
                            android:max="70"
                            android:maxHeight="3dip"
                            android:minHeight="3dip"
                            android:progress="0"
                            android:progressDrawable="@drawable/styled_seekbar_progress"
                            android:thumb="@drawable/seekbar_round" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/margin_medium"
                        android:layout_weight="2.5"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/goal_duration_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_medium"
                            android:background="@drawable/edt_txt_bg_rectangle"
                            android:drawableLeft="@drawable/minus"
                            android:drawablePadding="@dimen/margin_medium"
                            android:drawableRight="@drawable/plus"
                            android:gravity="center"
                            android:inputType="number"
                            android:padding="@dimen/margin_medium"
                            android:textAppearance="?android:attr/textAppearanceSmall" />

                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/goalreccurence_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:weightSum="2">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:layout_weight="1"
                        android:text="@string/goal_recurrence_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <RadioGroup
                            android:id="@+id/goal_recurrence_RadioRg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/switch_border"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <RadioButton
                                android:id="@+id/goal_no_RadioBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/switch_no"
                                android:button="@null"
                                android:gravity="center"
                                android:padding="@dimen/margin_medium"
                                android:text="@string/radio_no" />


                            <RadioButton
                                android:id="@+id/goal_yes_RadioBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/swithc_yes"
                                android:button="@null"
                                android:gravity="center"
                                android:padding="@dimen/margin_medium"
                                android:text="@string/radio_yes" />
                        </RadioGroup>

                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_goalFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:visibility="gone"
                    android:weightSum="2">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:layout_weight="1"
                        android:text="@string/goal_frequency_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/goal_frequency_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginRight="@dimen/margin_medium"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="6">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3.5"
                        android:gravity="center">

                        <SeekBar
                            android:id="@+id/goal_frequency_seekbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/margin_medium"
                            android:indeterminate="false"
                            android:max="70"
                            android:maxHeight="3dip"
                            android:minHeight="3dip"
                            android:progress="0"
                            android:progressDrawable="@drawable/styled_seekbar_progress"
                            android:thumb="@drawable/seekbar_round" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/margin_medium"
                        android:layout_weight="2.5"
                        android:background="@color/white"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/goal_frequency_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_medium"
                            android:background="@drawable/edt_txt_bg_rectangle"
                            android:drawableLeft="@drawable/minus"
                            android:drawablePadding="@dimen/margin_medium"
                            android:drawableRight="@drawable/plus"
                            android:gravity="center"
                            android:inputType="number"
                            android:padding="@dimen/margin_medium"
                            android:textAppearance="?android:attr/textAppearanceSmall" />
                    </LinearLayout>

                </LinearLayout>

                <!-- <LinearLayout
                    android:id="@+id/ll_goalRequrenceFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/StyledTilPaddedEditTextLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        app:hintTextAppearance="@style/StyledTilEditTextLabel">

                        <com.purplepath.purplepath.customview.NumberEditText
                            android:id="@+id/RequrenceFrequencyId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/margin_medium"
                            android:layout_weight="1"
                            android:hint="@string/goalrequrance"
                            android:maxLength="2"
                            android:textAppearance="?android:attr/textAppearanceSmall" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>-->


                <LinearLayout
                    android:id="@+id/ll_goalintervel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/goal_intervel_textinput"
                        style="@style/StyledTilPaddedEditTextLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        app:hintTextAppearance="@style/StyledTilEditTextLabel">

                        <com.purplepath.purplepath.customview.NumberEditText
                            android:id="@+id/goal_intervel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/margin_medium"
                            android:layout_weight="1"
                            android:hint="@string/goalintervel"
                            android:maxLength="2"
                            android:textAppearance="?android:attr/textAppearanceSmall" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/goal_frequency_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/goal_frequency_textinput"
                        style="@style/StyledTilPaddedEditTextLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        app:hintTextAppearance="@style/StyledTilEditTextLabel">

                        <com.purplepath.purplepath.customview.NumberEditText
                            android:id="@+id/goal_frequency_edts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/margin_medium"
                            android:layout_weight="1"
                            android:hint="@string/goal_frequency"
                            android:maxLength="2"
                            android:textAppearance="?android:attr/textAppearanceSmall" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/fragment_goal_monthandyear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:visibility="gone"
                    android:weightSum="2">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:layout_weight="1"
                        android:text="@string/goal_recurrence_selection_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <Spinner
                                android:id="@+id/goal_recurrence_year"
                                style="@style/Widget.AppCompat.Spinner.Underlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_toLeftOf="@+id/goal_recurrence_months"
                                android:layout_weight="1"
                                android:overlapAnchor="false"
                                android:paddingLeft="@dimen/margin_medium"

                                android:paddingRight="@dimen/margin_medium" />

                            <Spinner
                                android:id="@+id/goal_recurrence_months"
                                style="@style/Widget.AppCompat.Spinner.Underlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_weight="1"

                                android:overlapAnchor="false"
                                android:paddingLeft="@dimen/margin_medium"
                                android:paddingRight="@dimen/margin_medium" />
                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/goal_detail_importance_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="vertical">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:text="@string/goal_importance_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />
                    <Spinner
                        android:id="@+id/goal_detail_importance"
                        style="@style/Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_margin="@dimen/margin_medium"
                        android:overlapAnchor="false" />

                </LinearLayout>




                <LinearLayout
                    android:id="@+id/goal_detail_priority_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:text="@string/goal_priority_txt"

                        android:textAppearance="?android:attr/textAppearanceSmall" />

                    <Spinner
                        android:id="@+id/goal_detail_priority"
                        style="@style/Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_margin="@dimen/margin_medium"
                        android:overlapAnchor="false" />
                </LinearLayout>



                <LinearLayout
                    android:id="@+id/goal_detail_flexibility_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="vertical">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:text="@string/goal_flexibility_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                    <Spinner
                        android:id="@+id/goal_detail_flexibility"
                        style="@style/Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:overlapAnchor="false"

                        android:spinnerMode="dropdown" />
                </LinearLayout>



            <LinearLayout
                android:id="@+id/goal_expected_inc_edt_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/StyledTilPaddedEditTextLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:textColorHint="@color/dark_gray_text_colour"
                    app:hintTextAppearance="@style/StyledTilEditTextLabel">


                    <com.purplepath.purplepath.customview.PercentageEditText
                        android:id="@+id/goal_expected_inc_edt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="@dimen/margin_xlarge"
                        android:hint="@string/goal_expected_inc_txt"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>


            <LinearLayout
                android:id="@+id/goal_notes_edt_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:orientation="vertical">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/StyledTilPaddedEditTextLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:textColorHint="@color/dark_gray_text_colour"
                    app:hintTextAppearance="@style/StyledTilEditTextLabel">

                    <com.purplepath.purplepath.customview.CharacterEditText
                        android:id="@+id/goal_notes_edt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/margin_xlarge"
                        android:hint="@string/goal_notes_txt"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>


                <Button
                    android:id="@+id/goal_details_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_medium"
                    android:background="@color/colorPrimary"
                    android:gravity="center"
                    android:text="Save"
                    android:textColor="@color/white"
                    android:visibility="gone" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="150dp" />

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/bottom_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">

            <include layout="@layout/fragment_bottom_bar_view" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/bottom_bar_donelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:visibility="gone">

            <include
                layout="@layout/fragment_bottom_bar_done_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/goal_tick_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="@dimen/splash_button"
            android:layout_marginLeft="@dimen/fab_margin"
            android:layout_marginRight="@dimen/fab_margin"
            android:background="@color/colorPrimary"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_done_menu" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>


</LinearLayout>