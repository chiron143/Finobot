<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">
    <RelativeLayout
        android:id="@+id/logobannerViewId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_margin="@dimen/margin_xlarge">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:scaleType="center"
            android:background="@mipmap/ic_launcher"
            android:minHeight="84dp"
            android:minWidth="84dp"/>

    </RelativeLayout>
    <View
        android:id="@+id/dividerId"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:layout_below="@+id/logobannerViewId"
        android:background="@color/DarkGray"
        />

    <LinearLayout
        android:id="@+id/slideViewId"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/dividerId"
        android:orientation="vertical"
       >

        <cn.trinea.android.view.autoscrollviewpager.AutoScrollViewPager
            android:id="@+id/home_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            />

        <com.viewpagerindicator.CirclePageIndicator
            android:id="@+id/indicator"
            style="@style/CustomCirclePageIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:padding="@dimen/margin_small" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bottomViewId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/splash_button"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/sign_in_buttonId"
            android:gravity="center"
            android:layout_marginLeft="@dimen/margin_xxlarge"
            android:layout_marginRight="@dimen/margin_xxlarge"
            android:orientation="horizontal"
            android:weightSum="2">



            <Button
                android:id="@+id/loginBtnId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorAccent"
                android:layout_gravity="center"
                android:gravity="center"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@android:color/white"
                android:text="@string/track_your_finaces"
                />

            <com.google.android.gms.common.SignInButton
                android:id="@+id/sign_in_g"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:textAllCaps="false"
                android:visibility="gone"

                />
            <Button
                android:id="@+id/sign_in_button"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:clickable="true"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:text="@string/email_login"
                android:textAllCaps="false"
                android:padding="@dimen/margin_medium"
                android:visibility="gone"
                android:textColor="@color/colorPrimary" />


        </LinearLayout>
        <Button
            android:id="@+id/sign_in_buttonId"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:clickable="true"
            android:text="@string/email_signup"
            android:textAllCaps="false"
            android:visibility="gone"
            android:textColor="@color/colorPrimary" />
    </FrameLayout>

</RelativeLayout>