<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linear_layout"
        android:weightSum="4"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Spinner
            android:id="@+id/mobileNo_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/StyledTilEditText"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margin_medium"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <android.support.design.widget.TextInputLayout
            android:id="@+id/signupmobilenotilEditText"
            style="@style/StyledTilPaddedEditTextLayout"
            android:orientation="horizontal"
            android:layout_weight="3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">


            <EditText
                android:id="@+id/signup_mobile_no"
                style="@style/StyledTilEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:hint="@string/signup_mobileno"
                android:inputType="number"
                android:maxLength="10"
                android:imeOptions="actionSend"
                android:textAppearance="?android:attr/textAppearanceMedium" />
        </android.support.design.widget.TextInputLayout>



    </LinearLayout>
    <LinearLayout
        android:id="@+id/email_linear_layout"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <android.support.design.widget.TextInputLayout
            android:id="@+id/signupemailEditText"
            style="@style/StyledTilPaddedEditTextLayout"
            android:orientation="horizontal"
            android:layout_weight="3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">


            <EditText
                android:id="@+id/signup_email_id"
                style="@style/StyledTilEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:imeOptions="actionSend"
                android:textAppearance="?android:attr/textAppearanceMedium" />
        </android.support.design.widget.TextInputLayout>



    </LinearLayout>


    <RelativeLayout
        android:id="@+id/buttonlayoutmain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_below="@+id/email_linear_layout"
        android:layout_marginBottom="@dimen/margin_xxlarge">

        <LinearLayout
            android:id="@+id/layout_signup"
            android:layout_above="@+id/buttonlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/terms_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_large"
                android:text=""
                android:layout_gravity="center"
                android:gravity="center"
                android:checked="false"
                android:textColor="@color/dark_gray_text_colour"
                />
            <TextView
                android:id="@+id/txt_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_checkbox"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColorLink="@color/blue_signin"
                android:textColorHighlight="@color/dark_gray_text_colour"
                />


        </LinearLayout>
    <RelativeLayout
        android:id="@+id/buttonlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|center"
        android:layout_gravity="bottom"
        android:layout_alignParentBottom="true"
        android:background="@color/colorAccent"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:layout_marginLeft="@dimen/margin_xlarge"
        android:layout_marginRight="@dimen/margin_xlarge"
        android:layout_marginBottom="@dimen/margin_xxlarge">

        <Button
            android:id="@+id/bt_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorAccent"
            android:layout_gravity="center"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/white"
            android:text="@string/signup_txt"/>
    </RelativeLayout>
    </RelativeLayout>

</LinearLayout>
