<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".activity.LoginandSignUpActivity">
    <RelativeLayout
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/financial_assets_layout"
        android:layout_toLeftOf="@+id/financial_assets_edit_layout"
        android:weightSum="3"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/financial_assets_name"
            android:layout_weight="1"
            android:layout_margin="@dimen/margin_large"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Name"/>

        <TextView
            android:id="@+id/financial_assets_type_header"
            android:layout_weight="1"
            android:layout_margin="@dimen/margin_large"
            android:padding="@dimen/margin_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Type"/>


        <TextView
            android:id="@+id/financial_assets_currentvalue"
            android:layout_weight="1"
            android:layout_margin="@dimen/margin_large"
            android:padding="@dimen/margin_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Current Value"/>


    </LinearLayout>

        <RelativeLayout
            android:id="@+id/financial_assets_edit_layout"
            android:layout_alignParentRight="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/financial_assets_edit_rowitem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    android:src="@drawable/edit"/>


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/financial_assets_delete_rowitem"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_delet_icon"/>
            </LinearLayout>

        </RelativeLayout>

        <ListView
        android:id="@+id/financial_assets_list"
        android:layout_below="@+id/financial_assets_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </ListView>


    </RelativeLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/financial_assets_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:scaleType="fitXY"
        android:src="@drawable/ic_next_btn"
        android:visibility="visible" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>