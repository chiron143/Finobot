<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_margin="@dimen/margin_medium"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/margin_small"
        app:cardElevation="@dimen/margin_small"
        app:cardUseCompatPadding="true">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_medium"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/city_type" />

            <android.support.v7.widget.AppCompatSpinner
                android:id="@+id/cityType_spnr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overlapAnchor="false"
                style="@style/Widget.AppCompat.Spinner.Underlined">

            </android.support.v7.widget.AppCompatSpinner>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tax_slab" />

            <android.support.v7.widget.AppCompatSpinner
                android:id="@+id/taxSlab_spnr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overlapAnchor="false"
                style="@style/Widget.AppCompat.Spinner.Underlined">

            </android.support.v7.widget.AppCompatSpinner>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/opertunitycostLayId"
                style="@style/StyledTilPaddedEditTextLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:hint="@string/Opertunitycost"
                app:hintTextAppearance="@style/StyledTilEditTextLabel">

                <com.purplepath.purplepath.customview.PercentageEditText
                    android:id="@+id/opertunitycostId"
                    android:layout_width="match_parent"
                    android:maxLength="3"
                    android:layout_height="wrap_content"
                 />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/plannedoccupationLayId"
                style="@style/StyledTilPaddedEditTextLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                app:hintTextAppearance="@style/StyledTilEditTextLabel">

                <com.purplepath.purplepath.customview.NumberEditText
                    android:id="@+id/plannedoccupation_Edt_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:drawablePadding="@dimen/margin_xlarge"

                    android:maxLength="2"
                    android:maxLines="1"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/dark_gray_text_colour"
                    android:textColorHint="@color/app_text_color_gray" />

            </com.google.android.material.textfield.TextInputLayout>
            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/mainRepairEditId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:drawablePadding="@dimen/margin_xlarge"
                android:hint="@string/mainrepair"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour"
                android:textColorHint="@color/app_text_color_gray" />

            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/fualReapirExpEditId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:drawablePadding="@dimen/margin_xlarge"
                android:hint="@string/fualrunngexp"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour"
                android:textColorHint="@color/app_text_color_gray" />


            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/insuranceEditId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:drawablePadding="@dimen/margin_xlarge"
                android:hint="@string/insurance"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour"
                android:textColorHint="@color/app_text_color_gray" />


            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="100dp" />


        </LinearLayout>



        </ScrollView>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="@dimen/fab_margin"
            android:layout_marginLeft="@dimen/fab_margin"
            android:layout_marginRight="@dimen/fab_margin"
            android:scaleType="fitXY"
            android:visibility="visible"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_done_menu" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:gravity="bottom">

        <include layout="@layout/fragment_bottom_tool_bar" />
    </LinearLayout>

</RelativeLayout>