<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">
    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:padding="@dimen/margin_large"
        android:elevation="@dimen/margin_small"
        android:layout_marginLeft="@dimen/mar_left"
        android:layout_marginRight="@dimen/mar_left"
        android:layout_marginTop="@dimen/mar_left"
        android:background="@color/WhiteSmoke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_large"
            android:background="@color/WhiteSmoke">
            <RelativeLayout
                android:id="@+id/one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/my_cash_management"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Mycashmanagement"
                    android:padding="@dimen/margin_large"
                    android:gravity="center"
                    style="?android:textAppearanceLarge"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/deficit"
                    android:layout_below="@+id/my_cash_management"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_large"
                    android:layout_centerHorizontal="true"
                    android:maxLines="1"
                    android:text="₹ 0.00"
                    style="?android:textAppearanceLarge"
                    android:textAppearance="?android:attr/textAppearanceLarge"/>

                <TextView
                    android:id="@+id/txt_surplus"
                    android:layout_below="@+id/deficit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_large"
                    android:gravity="center"
                    style="?android:textAppearanceMedium"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textStyle="normal" />
            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>



    <androidx.cardview.widget.CardView
        android:id="@+id/card_view1"
        android:layout_below="@+id/card_view"
        android:padding="@dimen/margin_large"
        android:layout_marginTop="@dimen/mar_left"
        android:layout_marginLeft="@dimen/mar_left"
        android:layout_marginRight="@dimen/mar_left"
        android:elevation="@dimen/margin_small"
        android:background="@color/WhiteSmoke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/WhiteSmoke"
            android:padding="@dimen/margin_large">

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:text="@string/Value"
                style="?android:textAppearanceMedium"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold" />

            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_large"
                android:id="@+id/tab"
                android:layout_below="@+id/level">
                <TableRow>
                    <TextView
                        android:layout_column="1"
                        android:text="•"
                        android:layout_margin="@dimen/margin_large"
                        android:textSize="@dimen/bullet"
                        android:layout_marginLeft="@dimen/mar_left">
                    </TextView>
                    <TextView
                        android:layout_column="2"
                        android:layout_width="wrap_content"
                        android:textStyle="normal"
                        android:layout_margin="@dimen/margin_large"
                        android:text="@string/OverallIncome"
                        android:layout_marginLeft="@dimen/mar_left">
                    </TextView>

                    <TextView
                        android:layout_column="3"
                        android:layout_width="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:text="-"
                        android:layout_marginLeft="@dimen/mar_left">
                    </TextView>

                    <com.purplepath.purplepath.customview.DefaultCurrencyTextView
                        android:id="@+id/overall_income"
                        android:layout_column="4"
                        android:layout_width="wrap_content"
                        android:textStyle="normal"
                        android:text="₹ 0.00"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_marginLeft="@dimen/mar_left"/>
                </TableRow>
                <TableRow>
                    <TextView
                        android:layout_column="1"
                        android:text="•"
                        android:textSize="@dimen/bullet"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_marginLeft="@dimen/mar_left">
                    </TextView>
                    <TextView
                        android:layout_column="2"
                        android:layout_width="wrap_content"
                        android:textStyle="normal"
                        android:layout_margin="@dimen/margin_large"
                       android:text="@string/OverallExpense"
                        android:layout_marginLeft="@dimen/mar_left">
                    </TextView>

                    <TextView
                        android:layout_column="3"
                        android:layout_width="wrap_content"
                        android:textStyle="normal"
                        android:layout_margin="@dimen/margin_large"
                        android:text="-"
                        android:layout_marginLeft="@dimen/mar_left">
                    </TextView>

                    <com.purplepath.purplepath.customview.DefaultCurrencyTextView
                        android:id="@+id/overall_experience"
                        android:layout_column="4"
                        android:layout_width="wrap_content"
                        android:textStyle="normal"
                        android:text="₹ 0.00"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_marginLeft="@dimen/mar_left"/>
                </TableRow>

                <TableRow>

                </TableRow>
            </TableLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
        </RelativeLayout>
    </ScrollView>
    <com.github.clans.fab.FloatingActionMenu
        android:id="@+id/cashmanagement_floating_action_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_alignParentRight="true"
        fab:menu_animationDelayPerItem="55"
        fab:menu_buttonSpacing="0dp"
        fab:menu_colorNormal="#7a0098"
        fab:menu_colorPressed="#7a0098"
        fab:menu_colorRipple="#99d4d4d4"
        fab:menu_fab_size="normal"
        fab:menu_icon="@drawable/fab_add"
        fab:menu_labels_colorNormal="#80000000"
        fab:menu_labels_colorPressed="#80000000"
        fab:menu_labels_colorRipple="#66efecec"
        fab:menu_labels_cornerRadius="3dp"
        fab:menu_labels_ellipsize="none"
        fab:menu_labels_showAnimation="@anim/fab_slide_in_from_right"
        fab:menu_labels_hideAnimation="@anim/fab_slide_out_to_right"
        fab:menu_labels_margin="0dp"
        fab:menu_labels_maxLines="-1"
        fab:menu_labels_padding="8dp"
        fab:menu_labels_position="left"
        fab:menu_labels_showShadow="true"
        fab:menu_labels_singleLine="false"
        fab:menu_labels_textColor="#f2f1f1"
        fab:menu_labels_textSize="15sp"
        fab:menu_openDirection="up"
        fab:menu_shadowColor="#66aff198"
        fab:menu_shadowRadius="4dp"
        fab:menu_shadowXOffset="1dp"
        fab:menu_shadowYOffset="4dp"
        fab:menu_showShadow="true">


        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fab_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#90000000"
            fab:fab_label="Income"
            fab:fab_colorPressed="@color/white"
            fab:fab_size="mini"
            fab:fab_colorNormal="#ffffff"/>
        <!--app:srcCompat="@drawable/ic_incomefloat_icon"-->

        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fab_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#90000000"
            fab:fab_colorPressed="@color/white"
            fab:fab_label="Expense"
            fab:fab_size="mini"
            fab:fab_colorNormal="#ffffff"/>
        <!--app:srcCompat="@drawable/ic_expensefloat_icon"-->

    </com.github.clans.fab.FloatingActionMenu>
    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>
</RelativeLayout>
