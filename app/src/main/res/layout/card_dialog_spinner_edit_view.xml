<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_centerInParent="true"
    android:background="@color/transparent_black">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/alert_border_curve">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium">

            <TextView
                android:id="@+id/txt_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:gravity="center"
                android:text="Update"
                android:textStyle="bold"
                android:textAppearance="?android:attr/textAppearanceMedium" />
        </LinearLayout>

        <View
            android:id="@+id/viewlogoRasi"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#C2C2C2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_xlarge"
            android:layout_marginRight="@dimen/margin_large">

            <TextView
                android:id="@+id/txt_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:text="Question"
                android:textStyle="bold"
                android:textAppearance="?android:attr/textAppearanceMedium" />
        </LinearLayout>


       <!--need to work-->
        <LinearLayout
            android:id="@+id/bottomViewId"
            android:paddingLeft="@dimen/margin_large"
            android:paddingRight="@dimen/margin_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true">

            <LinearLayout
                android:id="@+id/dialog_layout_character_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
           android:visibility="gone"
                android:orientation="horizontal">

                <com.purplepath.purplepath.customview.CustomTextInputLayout
                    android:id="@+id/Character_InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_medium"
                    android:gravity="center"
                    app:hintTextAppearance="@style/StyledTilEditTextFloatingLabel">

                    <com.purplepath.purplepath.customview.CharacterEditText
                        android:id="@+id/dialog_character_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:hint=""
                        android:maxLines="1"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/dark_gray_text_colour"
                        android:textColorHint="@color/app_text_color_gray"
                        android:windowSoftInputMode="stateVisible|adjustResize" />
                </com.purplepath.purplepath.customview.CustomTextInputLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/dialog_layout_percentage_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
android:visibility="gone"
                android:orientation="horizontal">

                <com.purplepath.purplepath.customview.CustomTextInputLayout
                    android:id="@+id/percentage_InputLayout"
                    android:layout_width="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    app:hintTextAppearance="@style/StyledTilEditTextFloatingLabel">
                    <com.purplepath.purplepath.customview.PercentageEditText
                        android:id="@+id/dialog_percentage_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:hint=""
                        android:maxLines="1"
                        android:windowSoftInputMode="stateVisible|adjustResize"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/dark_gray_text_colour"
                        android:textColorHint="@color/app_text_color_gray" />
                </com.purplepath.purplepath.customview.CustomTextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/dialog_layout_number_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
android:visibility="gone"
                android:orientation="horizontal">

                <com.purplepath.purplepath.customview.CustomTextInputLayout
                    android:id="@+id/number_InputLayout"
                    android:layout_width="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    app:hintTextAppearance="@style/StyledTilEditTextFloatingLabel">
                    <com.purplepath.purplepath.customview.NumberEditText
                        android:id="@+id/dialog_number_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:hint=""
                        android:maxLines="1"
                        android:windowSoftInputMode="stateVisible|adjustResize"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/dark_gray_text_colour"
                        android:textColorHint="@color/app_text_color_gray" />
                </com.purplepath.purplepath.customview.CustomTextInputLayout>


            </LinearLayout>


            <LinearLayout
                android:id="@+id/dialog_layout_currencydefault_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
android:visibility="gone"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    app:hintTextAppearance="@style/StyledTilEditTextLabel">
                <com.purplepath.purplepath.customview.CurrencyGhostViewTaxFiling
                    android:id="@+id/dialog_currencydefault_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:hint=""
                    android:inputType="numberDecimal"
                    android:textColor="@color/dark_gray_text_colour"
                    android:textColorHint="@color/app_text_color_gray" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:text="@string/dialog_no"
                android:textColor="@color/white"
                android:layout_marginRight="@dimen/margin_small" />

            <Button
                android:id="@+id/yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:text="@string/dialog_yes"
                android:textColor="@color/white"
                />

        </LinearLayout>

    </LinearLayout>


</RelativeLayout>
