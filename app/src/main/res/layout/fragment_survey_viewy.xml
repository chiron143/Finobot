<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <FrameLayout
                android:id="@+id/relativelayout_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge">



                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <android.support.v7.widget.CardView
                        android:id="@+id/card_root"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="5dp"
                        android:layout_marginTop="@dimen/margin_large"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_large"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_xxlarge"
                                android:layout_gravity="center">
                                <TextView
                                    android:id="@+id/questions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    tools:text="Investment Horizon (in years)"
                                    android:layout_margin="@dimen/margin_large"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/ampm_label_size"/>
                            </RelativeLayout>

                            <View
                                android:id="@+id/view_separator_id"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/AntiqueWhite" />


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/margin_xlarge">
                                <RadioGroup
                                    android:id="@+id/radioGroup1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/margin_medium"
                                    android:layout_marginLeft="@dimen/fab_margin"
                                    android:layout_marginRight="@dimen/margin_medium"
                                    android:layout_marginBottom="@dimen/margin_medium">

                                    <RadioButton
                                        android:id="@+id/optionA"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/margin_large"
                                        android:textSize="@dimen/ampm_label_size"
                                        android:text="" />

                                    <RadioButton
                                        android:id="@+id/optionB"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/ampm_label_size"
                                        android:layout_margin="@dimen/margin_large"
                                        android:text="" />

                                    <RadioButton
                                        android:id="@+id/optionC"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/ampm_label_size"
                                        android:layout_margin="@dimen/margin_large"
                                        android:text="" />

                                </RadioGroup>

                            </LinearLayout>



                            <LinearLayout
                                android:id="@+id/layout_wrong_answer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:orientation="horizontal">

                                <android.support.v7.widget.AppCompatImageView
                                    android:id="@+id/dummy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/margin_large"/>
                                <!--  app:srcCompat="@drawable/ic_finobot_icon"-->
                                <TextView
                                    android:id="@+id/answer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="@dimen/margin_large"
                                    android:textSize="@dimen/ampm_label_size"
                                    android:textStyle="bold"/>

                                <android.support.v7.widget.AppCompatImageView
                                    android:id="@+id/wrong_right"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="@dimen/margin_large"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/layout_correct_answer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/correct_answer_toast"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="@dimen/margin_large"
                                    android:textSize="@dimen/ampm_label_size"
                                    android:textStyle="bold"/>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layout_done"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_gravity="right">


                                <android.support.design.widget.FloatingActionButton
                                    android:id="@+id/done"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_centerInParent="true"
                                    android:layout_margin="@dimen/fab_margin"
                                    app:srcCompat="@drawable/ic_done_calender" />

                                <!--<android.support.design.widget.FloatingActionButton-->
                                    <!--android:id="@+id/right_arrow_nextpage"-->
                                    <!--android:layout_width="wrap_content"-->
                                    <!--android:layout_height="wrap_content"-->
                                    <!--app:srcCompat="@drawable/ic_next_arrow"-->
                                    <!--android:layout_alignParentRight="true"-->
                                    <!--android:layout_margin="@dimen/fab_margin"/>-->
                            </LinearLayout>
                        </LinearLayout>


                    </android.support.v7.widget.CardView>

                </RelativeLayout>

                <FrameLayout
                    android:id="@+id/farmeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                    <LinearLayout
                        android:id="@+id/layout_question_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginLeft="@dimen/margin_medium"
                        android:layout_marginRight="@dimen/margin_medium"
                        android:background="@drawable/quizbackgroundblue"
                        android:layout_gravity="center"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/margin_xxlarge"
                            android:layout_marginRight="@dimen/margin_xxlarge"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txt_question_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Survey  -"
                                android:textColor="@color/white"
                                android:background="@color/blue"
                                android:layout_margin="@dimen/margin_large"
                                android:layout_gravity="center"
                                android:textSize="@dimen/styledtil_edit_text_size"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/question_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="@dimen/styledtil_edit_text_size"
                                android:textColor="@color/white"
                                android:background="@color/blue"
                                android:layout_margin="@dimen/margin_large"
                                android:layout_gravity="center"
                                android:textStyle="normal" />
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>



            </FrameLayout>




        </LinearLayout>
    </ScrollView>
    <!--<LinearLayout-->
    <!--android:id="@+id/bottom_bar_layout"-->
    <!--android:gravity="bottom"-->
    <!--android:layout_alignParentBottom="true"-->
    <!--android:layout_gravity="bottom"-->
    <!--android:layout_width="match_parent"-->
    <!--android:layout_height="wrap_content">-->
    <!--<include layout="@layout/fragment_bottom_tool_bar"/>-->
    <!--</LinearLayout>-->
</RelativeLayout>
