<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_margin="@dimen/margin_xlarge"

    >
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_margin="@dimen/margin_xlarge"
    android:weightSum="2">

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/incomeTotalTxtId"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_margin="@dimen/margin_xlarge"
                android:gravity="center|left"
                android:text="Salary"
                android:layout_weight="0.75"
                android:textColor="@color/text_header_colour"
                android:padding="@dimen/margin_large"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1.25"
        android:layout_height="wrap_content"
        >
            <com.purplepath.purplepath.customview.CurrencyGroupView
                android:id="@+id/incomeTotalEditId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:padding="@dimen/margin_large"
                android:layout_alignParentRight="true"
                android:inputType="numberDecimal"


                />
        <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/lifeExptImgPopView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_gravity="center"
            app:srcCompat="@drawable/ic_pop_up"
            android:adjustViewBounds="true"
        android:padding="@dimen/margin_small"
        android:visibility="gone"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/calExpImgListView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_pop_up"
            android:adjustViewBounds="true"
            android:padding="@dimen/margin_small"
            android:visibility="gone"/>

    </LinearLayout>
</LinearLayout>
    </LinearLayout>