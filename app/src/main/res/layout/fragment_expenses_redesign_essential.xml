<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/cartoonView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/fragment_asset_view"
        android:visibility="gone"
        />

    <ScrollView
        android:id="@+id/scrollViewId"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/exp_linearlayout">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/total_layout"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >


                <!--<TextView-->
                    <!--android:layout_width="0dp"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:layout_margin="@dimen/margin_medium"-->
                   <!--android:visibility="gone"-->
                    <!--android:text="Total"/>-->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    app:hintTextAppearance="@style/StyledTilEditTextLabel"
                    android:layout_weight="1"
                    android:layout_gravity="center">


                    <com.purplepath.purplepath.customview.CurrencyDefaultEdt
                        android:id="@+id/currencyEditTxtTotal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:drawablePadding="@dimen/margin_xlarge"
                        android:hint="Total"
                        android:enabled="false"
                        android:focusableInTouchMode="false"
                        android:inputType="none"
                        android:textColorHint="@color/app_text_color_gray"
                        android:gravity="left|center_horizontal"
                        android:textAppearance="?android:attr/textAppearanceSmall" />
                </com.google.android.material.textfield.TextInputLayout>


            </LinearLayout>
            <LinearLayout
                android:layout_below="@+id/total_layout"
                android:id="@+id/epenses_row_layout"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/redesign_essential_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/exp_linearlayout"
        android:layout_alignParentRight="true"
        android:layout_margin="@dimen/fab_margin"
        android:background="@color/colorPrimary"
        app:srcCompat="@drawable/ic_pls_icon"
        android:scaleType="fitXY"
        android:visibility="visible" />
    <LinearLayout
        android:id="@+id/exp_linearlayout"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_bar_view"/>

    </LinearLayout>


</RelativeLayout>