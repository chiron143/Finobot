                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Income After Tax"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/income_after_tax_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"/>
                </LinearLayout>


            </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/your_entitle_cardlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_marginRight="@dimen/margin_xlarge"
                android:background="@color/WhiteSmoke"
                android:elevation="@dimen/margin_small">

                <LinearLayout
                    android:id="@+id/your_entitle_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:background="@color/tax_summary_light_gray">

                    <TextView
                        android:id="@+id/savingsTopText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your entitlement for tax savings, overall"
                        android:layout_marginTop="@dimen/margin_large"
                        android:layout_marginRight="@dimen/margin_large"
                        android:layout_marginLeft="@dimen/margin_large"
                        android:layout_marginBottom="@dimen/margin_xlarge"                        />

                    <com.purplepath.purplepath.customview.CurrencyTextView
                        android:id="@+id/entitled_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_centerHorizontal="true"
                        android:maxLines="1"
                        android:textColor="@color/dark_gray_text_colour"
                        style="?android:textAppearanceMedium"
                        android:textStyle="bold"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0.3dp"
                        android:background="@color/gray"/>


                    <TextView
                        android:id="@+id/availedTopText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your availed tax savings, thus for"
                        android:layout_marginTop="@dimen/margin_large"
                        android:layout_marginRight="@dimen/margin_large"
                        android:layout_marginLeft="@dimen/margin_large"
                        android:layout_marginBottom="@dimen/margin_xlarge"
                        />

                    <com.purplepath.purplepath.customview.CurrencyTextView
                        android:id="@+id/availed_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_centerHorizontal="true"
                        android:maxLines="1"
                        style="?android:textAppearanceMedium"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0.3dp"
                        android:background="@color/gray"/>
                    <TextView
                        android:id="@+id/pendingTopText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your pending opportunities for tax savings, further"
                        android:layout_marginTop="@dimen/margin_large"
                        android:layout_marginRight="@dimen/margin_large"
                        android:layout_marginLeft="@dimen/margin_large"
                        android:layout_marginBottom="@dimen/margin_xlarge"/>

                    <com.purplepath.purplepath.customview.CurrencyTextView
                        android:id="@+id/pending_value"
                        style="?android:textAppearanceMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"
                        android:text=""
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"/>


                    <LinearLayout
                        android:id="@+id/see_more_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end">

                        <TextView
                            android:id="@+id/txt_show_more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Show More Details"
                            android:textSize="@dimen/text_size"
                            android:textColor="@color/Purple"/>

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/see_more_layouts"
                        android:layout_width="wrap_content"
                        android:layout_height="1dp"
                        android:layout_gravity="end"
                        android:background="@color/colorPrimary">


                        <TextView
                            android:id="@+id/txt_show_mores"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Show More Details"
                            android:textSize="@dimen/text_size"
                            android:textColor="@color/Purple"/>

                    </LinearLayout>


                </LinearLayout>






            </androidx.cardview.widget.CardView>

            <android.widget.Space
                android:id="@+id/card_space"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="100dp" />





            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/summary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Summary Text"
                    android:layout_marginLeft="@dimen/margin_xlarge"
                  android:padding="@dimen/margin_small"/>
                <LinearLayout
                    android:id="@+id/contact_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_medium"
                    android:layout_gravity="end"
                    android:layout_margin="@dimen/margin_large"
                    android:orientation="horizontal"
                    android:background="@drawable/tax_summary_background">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_tax_summary_contact_us"/>

                    <TextView
                        android:id="@+id/txt_contactus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=" Call Now  "
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_tax_summary_arrow"/>
                </LinearLayout>
            </LinearLayout>


            <android.widget.Space
                android:id="@+id/card_space1"
                android:layout_width="match_parent"
                android:layout_height="100dp" />


        </LinearLayout>


    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/rating_floating_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_gravity="bottom|end"
        android:layout_marginLeft="@dimen/fab_margin"
        android:layout_marginRight="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:background="@color/colorPrimary"
        android:scaleType="fitXY"
        app:fabSize="normal"

        app:srcCompat="@drawable/ic_done_tick_tax"
        android:visibility="visible"
        android:layout_above="@+id/bottom_bar_layout"
        />
    <!-- app:srcCompat="@drawable/ic_tax_rating"-->

    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>

    </LinearLayout>


</RelativeLayout>
