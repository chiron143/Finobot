            <androidx.cardview.widget.CardView
                android:id="@+id/card_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_xlarge"
                android:background="@color/WhiteSmoke"
                android:elevation="@dimen/margin_small">
            <LinearLayout
                android:id="@+id/layout_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tax_summary_light_purple"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_income_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Income"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/income_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"/>
                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tax_summary_light_gray"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_excemption_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Exemption"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/exemption_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tax_summary_light_purple"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_gross_income_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Gross Income"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/gross_income_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tax_summary_light_gray"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_deduction_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Deduction"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/deduction_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tax_summary_light_purple"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_rebates_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Rebates"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/rebates_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tax_summary_light_gray"

                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_total_taxable_income_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Total Taxable Income"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/total_taxable_income_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:maxLines="1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tax_summary_light_purple"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_liability_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:layout_marginLeft="@dimen/margin_xlarge"
                        android:text="Tax Liability"
                        android:textStyle="bold"
                        android:textColor="@color/dark_gray_text_colour"
                        android:maxLines="2"/>

                    <TextView
                        android:id="@+id/liability_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="0"
