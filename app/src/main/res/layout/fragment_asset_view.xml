<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".activity.LoginandSignUpActivity">

    <RelativeLayout
        android:id="@+id/asset_demoViewId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">
        <RelativeLayout
            android:id="@+id/goal_header_bg_relativelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/goal_bottom_bg_imageView"

                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_centerHorizontal="true"
                android:src="@drawable/empty_logo"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/goal_plus_btn_framelayout"
            android:layout_below="@+id/goal_header_bg_relativelayout"
            android:layout_centerHorizontal="true"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <!--<ImageView-->
            <!--android:id="@+id/goal_plus_bg_imageView"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:src="@drawable/goal_plus_bg"/>-->

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/goal_click_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_add_icon_big"
                android:visibility="gone"/>

        </FrameLayout>


        <TextView
            android:id="@+id/goal_headear_bg_TxtView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="@dimen/margin_large"
            android:layout_below="@+id/goal_plus_btn_framelayout"
            android:textColor="@color/dark_gray_text_colour"
            android:textSize="@dimen/day_number_size"
            android:text="Please Add Goal By Clicking the + Button"/>
    </RelativeLayout>



</android.support.design.widget.CoordinatorLayout>
