<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.purplepath.purplepath.desiproAllModules.houseBuyVsRent.ResultBuyVsRentFragment">




    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margin_medium"
        android:layout_alignParentTop="true"
        android:layout_above="@+id/view"/>

<View
    android:id="@+id/view"
    android:layout_width="match_parent"
    android:layout_centerInParent="true"
    android:layout_marginBottom="@dimen/margin_xlarge"
    android:layout_height="10dp"/>

    <androidx.cardview.widget.CardView
        android:layout_below="@+id/view"
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/WhiteSmoke"
        android:layout_margin="@dimen/margin_xlarge"
        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/margin_xlarge">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/costOfRenting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/view1"
                android:layout_marginLeft="@dimen/margin_medium"
                android:layout_marginRight="@dimen/margin_medium"
                android:text="Net annual cost of Lease " />
            <View
                android:id="@+id/view1"
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_centerInParent="true"/>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/costOfRentingValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_toRightOf="@+id/view1"
                android:text="₹ 0" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/usingCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_medium"
                android:layout_toLeftOf="@+id/view2"
                android:layout_marginRight="@dimen/margin_medium"
                android:text="Cost to buy a Car, using cash" />

            <View
                android:id="@+id/view2"
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_centerInParent="true"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/buyUsingCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_toRightOf="@+id/view2"
                android:text="₹ 0" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/usingFinance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/view3"
                android:layout_marginLeft="@dimen/margin_medium"
                android:layout_marginRight="@dimen/margin_medium"
                android:text="Cost to buy a Car, using finance " />

            <View
                android:id="@+id/view3"
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_centerInParent="true"/>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/buyUsingFinanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_toRightOf="@+id/view3"
                android:text=" ₹ 0" />

        </RelativeLayout>

    </LinearLayout>
    </androidx.cardview.widget.CardView>




    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:visibility="visible"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>

    </LinearLayout>

</RelativeLayout>
