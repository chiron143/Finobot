<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context="com.purplepath.purplepath.taxanalysis.TaxPlanSummary">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <android.support.v7.widget.CardView
            android:id="@+id/your_entitle_cardlayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_view_height"
            android:layout_margin="@dimen/margin_small"
            android:background="@color/WhiteSmoke"
            android:elevation="@dimen/margin_small">

            <LinearLayout
                android:id="@+id/your_entitle_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:background="@color/WhiteSmoke">



                <TextView
                    android:id="@+id/txt_tax_plan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tax Plan Details"
                    android:layout_margin="@dimen/margin_large"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size"
                    style="?android:textAppearanceMedium"/>


                <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tax_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More Details"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_gravity="end"
                    android:padding="@dimen/margin_large"
                    android:background="@drawable/prompt_text_right_corner_purple"
                    />


            </LinearLayout>


        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/tax_savingavalied_cardlayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_view_height"
            android:layout_margin="@dimen/margin_medium"
            android:background="@color/WhiteSmoke"
            android:elevation="@dimen/margin_small">

            <LinearLayout
                android:id="@+id/tax_savingavalied_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/WhiteSmoke">

                <TextView
                    android:id="@+id/txt_tax_clasification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tax Analysis"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size"
                    android:layout_margin="@dimen/margin_large"
                    style="?android:textAppearanceMedium"/>


                <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tax_clasification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More Details"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_gravity="end|bottom"
                    android:padding="@dimen/margin_large"
                    android:background="@drawable/prompt_text_right_corner_purple"
                   />
            </LinearLayout>


        </android.support.v7.widget.CardView>
        <android.support.v7.widget.CardView
            android:id="@+id/youhava_pendingamount_cardlayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_view_height"
            android:layout_margin="@dimen/margin_medium"
            android:background="@color/WhiteSmoke"
            android:elevation="@dimen/margin_small">

            <LinearLayout
                android:id="@+id/youhava_pendingamount_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/WhiteSmoke">

                <TextView
                    android:id="@+id/txt_tax_recommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tax Recommendation"
                    android:layout_margin="@dimen/margin_large"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size"
                    style="?android:textAppearanceMedium"/>


                <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tax_recommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More Details"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_gravity="end"
                    android:padding="@dimen/margin_large"
                    android:background="@drawable/prompt_text_right_corner_purple"
                    />
            </LinearLayout>


        </android.support.v7.widget.CardView>


    </LinearLayout>
    <android.support.design.widget.FloatingActionButton
        android:id="@+id/fab_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_below="@+id/linear_layout"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="@dimen/fab_margin"
        android:layout_marginRight="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:background="@color/colorPrimary"
        android:layout_above="@+id/bottom_bar_layout"
        android:scaleType="fitXY"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_edit_feedback"
        android:visibility="gone"/>
    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>

    </LinearLayout>


</RelativeLayout>
