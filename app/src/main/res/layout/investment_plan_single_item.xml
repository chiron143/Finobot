<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_xlarge">

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_view_height"
        android:layout_margin="@dimen/margin_small"
        android:background="@color/WhiteSmoke"
        android:elevation="@dimen/margin_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/WhiteSmoke"
            android:orientation="vertical">

            <android.support.v7.widget.AppCompatTextView
                android:id="@+id/card_title"
                android:layout_gravity="center_horizontal"
                style="?android:textAppearanceSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:layout_alignParentLeft="true"
                android:text="Upon Drilldown"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold|italic" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/plan_text"
                style="?android:textAppearanceSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:layout_alignParentLeft="true"
                android:text="Plan"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/plan_value"
                android:layout_toRightOf="@+id/plan_text"
                android:layout_toLeftOf="@+id/view1"
                style="?android:textAppearanceSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:text="Plan"
                android:textAppearance="?android:attr/textAppearanceLarge" />
                <View
                    android:id="@+id/view1"
                    android:layout_centerInParent="true"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    />
                <com.purplepath.purplepath.customview.CustomTextView
                    android:layout_toRightOf="@+id/view1"
                    android:id="@+id/varianceRupee_text"
                    style="?android:textAppearanceSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_large"
                    android:text="Variance( ₹ )"
                    android:textAppearance="?android:attr/textAppearanceLarge" />

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/varianceRupee_value"
                    android:layout_toRightOf="@+id/varianceRupee_text"
                    style="?android:textAppearanceSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_large"
                    android:text="Plan"
                    android:textAppearance="?android:attr/textAppearanceLarge" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/actual_text"
                style="?android:textAppearanceSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:layout_alignParentLeft="true"
                android:text="Actual"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/actual_value"
                android:layout_toRightOf="@+id/actual_text"
                android:layout_toLeftOf="@+id/view2"
                style="?android:textAppearanceSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:text="actual "
                android:textAppearance="?android:attr/textAppearanceLarge" />
                <View
                    android:id="@+id/view2"
                    android:layout_centerInParent="true"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    />
                <com.purplepath.purplepath.customview.CustomTextView
                    android:layout_toRightOf="@+id/view2"
                    android:id="@+id/variancePercent_text"
                    style="?android:textAppearanceSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_large"
                    android:text="Variance( % ) "
                    android:textAppearance="?android:attr/textAppearanceLarge" />

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/variancePercent_value"
                    android:layout_toRightOf="@+id/variancePercent_text"
                    style="?android:textAppearanceSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_large"
                    android:text="Plan"
                    android:textAppearance="?android:attr/textAppearanceLarge" />


            </RelativeLayout>
        </LinearLayout>

    </android.support.v7.widget.CardView>

</LinearLayout>