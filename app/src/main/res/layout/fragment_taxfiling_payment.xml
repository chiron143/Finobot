                        android:textColor="@color/hint_color"
                        android:layout_marginLeft="@dimen/bullet"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textStyle="bold"/>

                </FrameLayout>

            </android.support.v7.widget.CardView>

