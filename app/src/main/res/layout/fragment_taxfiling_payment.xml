<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="9dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <android.support.v7.widget.CardView
                android:id="@+id/cardview_free"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:background="@color/WhiteSmoke"
                android:elevation="@dimen/margin_large"
                app:cardCornerRadius="5dp"
                app:cardElevation="5dp"
                app:cardUseCompatPadding="true">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@color/WhiteSmoke">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_margin="@dimen/margin_large"
                        android:textSize="@dimen/month_label_size"
                        android:text="Zero Plan"
                        android:textColor="@color/dark_gray_text_colour" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5px"
                        android:layout_marginTop="@dimen/margin_large"
                        android:background="@color/DarkGray"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="If your income is less than ₹ 50 Lakhs and earned from only one source, i.e. either one of the below:"
                        android:layout_margin="@dimen/margin_xlarge"/>
                    <LinearLayout
                        android:id="@+id/layout_viewmore_click_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/form16_viewmore"
                            android:textColor="@color/hint_color"
                            android:layout_marginLeft="@dimen/bullet"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_freecard_information"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_margin="@dimen/margin_large"
                        android:weightSum="4">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:layout_weight="0.2"
                            android:text="•"
                            android:layout_marginLeft="@dimen/mar_left"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:text="Salary (one Form 16)"
                            android:layout_weight="3.8"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_margin="@dimen/margin_large"
                        android:weightSum="4">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:layout_weight="0.2"
                            android:text="•"
                            android:layout_marginLeft="@dimen/mar_left"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:text="Pension"
                            android:layout_weight="3.8"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_margin="@dimen/margin_large"
                        android:weightSum="4">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:layout_weight="0.2"
                            android:text="•"
                            android:layout_marginLeft="@dimen/mar_left"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:text="One house property"
                            android:layout_weight="3.8"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:text="Exclusions: no filing of previous year tax returns, no carried forward losses, no clubbing of income, no foreign income, no business income"
                        android:layout_margin="@dimen/margin_xlarge"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="Note:"
                        android:layout_marginLeft="@dimen/margin_xlarge"/>
                    <TextView
                        android:id="@+id/incometax_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:textColorLink="@color/blue_signin"
                        android:text="For Zero Plan, you will not be getting any of our value-added services, like Maximum Tax Savings, CA Verification, and Stand-by Support to Responding to Notices. And you will be filing your ITR by yourself at https://incometaxindiaefiling.gov.in/ using the XML File we send to you; with the help of our instructions."
                        android:layout_margin="@dimen/margin_xlarge"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_free_click"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginRight="@dimen/margin_large"
                        android:layout_marginBottom="@dimen/margin_large"
                        android:padding="@dimen/margin_small"
                        android:orientation="horizontal"
                        android:background="@drawable/tax_summary_background">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/margin_small"
                            android:text="Continue"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                    </LinearLayout>


                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end">

                    <android.support.v7.widget.AppCompatImageView
                        android:id="@+id/tax_planning_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:padding="@dimen/margin_small"
                        app:srcCompat="@drawable/ic_taxfree_icon" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/free_view_less"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_xlarge"
                    android:visibility="gone"
                    android:layout_gravity="bottom">

                    <TextView
