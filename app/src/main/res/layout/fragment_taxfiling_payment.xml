                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:text="One house property"
                            android:layout_weight="3.8"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:text="Exclusions: no filing of previous year tax returns, no carried forward losses, no clubbing of income, no foreign income, no business income"
                        android:layout_margin="@dimen/margin_xlarge"/>
                </LinearLayout>
                    <LinearLayout
                        android:id="@+id/itr1_click_first"
