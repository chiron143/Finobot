<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2sp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:background="@color/WhiteSmoke"
            android:elevation="@dimen/margin_small"
            app:cardElevation="10sp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="5sp"
                android:gravity="center"
                android:orientation="vertical">

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/text_group_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_very_small"
                    android:gravity="center"
                    android:text="Eqity"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="2sp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="You have to contribute"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5sp"
                        android:gravity="center"
                        android:text="@string/Rs"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="visible" />

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:id="@+id/text_contribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="3sp"
                        android:gravity="center"
                        android:text="900000"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="visible" />

                    <Spinner
                        android:id="@+id/spinner_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="5sp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="to accumulate"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5sp"
                        android:gravity="center"
                        android:text="@string/Rs"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:id="@+id/text_accumulation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="3sp"
                        android:gravity="center"
                        android:text="1900000"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <com.purplepath.purplepath.customview.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="3sp"
                        android:gravity="center"
                        android:text="in"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:id="@+id/text_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="3sp"
                        android:gravity="center"
                        android:text="5 years 2 months"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/ampm_text_color"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/text_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_very_small"
                    android:drawableRight="@drawable/ic_baseline_arrow_forward_24px"
                    android:gravity="center"
                    android:text="@string/view_more"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>