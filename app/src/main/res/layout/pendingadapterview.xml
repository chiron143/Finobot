<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/parentViewId"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="vertical">

        <android.support.v7.widget.CardView
            android:id="@+id/card_view"
            android:padding="@dimen/margin_large"
            android:elevation="@dimen/margin_small"
            android:layout_margin="@dimen/margin_large"
            android:background="@color/WhiteSmoke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/WhiteSmoke"
                android:weightSum="7">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/WhiteSmoke"
                    android:orientation="horizontal"
                    android:layout_weight="2"
                    android:weightSum="5"
                    >
                    <TextView
                        android:id="@+id/category_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="@string/category"
                        />


                    <TextView
                        android:id="@+id/amount_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="@string/amount"
                        />


                    <TextView
                        android:id="@+id/notification_date_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="@string/notification_date"
                        />


                    <TextView
                        android:id="@+id/paid_date_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="@string/pay_date"
                        />

                    <TextView
                        android:id="@+id/due_date_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="@string/due_date"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:weightSum="5">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/WhiteSmoke"
                    android:orientation="horizontal"
                    android:layout_weight="2"
                    android:weightSum="5"
                    >
                    <TextView
                        android:id="@+id/category_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="Bike"
                        />


                    <TextView
                        android:id="@+id/amount_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="3000"
                        />


                    <TextView
                        android:id="@+id/notification_date_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="01/Feb/2016"
                        />


                    <TextView
                        android:id="@+id/paid_date_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="01/Feb/2016"
                        />

                    <TextView
                        android:id="@+id/due_date_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:text="01/Feb/2016"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/WhiteSmoke"
                    android:orientation="horizontal"
                    android:layout_weight="2"
                    android:weightSum="5"
                    >
                    <TextView
                        android:id="@+id/category"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:visibility="invisible"
                        android:text="Bike"
                        />
                    <TextView
                        android:id="@+id/amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:visibility="invisible"
                        android:text="3000"
                        />
                    <TextView
                        android:id="@+id/notification_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:visibility="invisible"
                        android:text="01/Feb/2016"
                        />
                    <ImageView
                        android:id="@+id/paid_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:src="@drawable/ic_navi_personal_selected"
                        android:text="01/Feb/2016"
                        />
                    <ImageView
                        android:id="@+id/calenderimage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_large"
                        android:layout_weight="1"
                        android:src="@drawable/ic_navi_personal_selected"
                        android:text="01/Feb/2016"
                        />
                </LinearLayout>
            </LinearLayout>
        </android.support.v7.widget.CardView>



    </LinearLayout>

</LinearLayout>
