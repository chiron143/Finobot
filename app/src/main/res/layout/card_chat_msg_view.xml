<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:elevation="@dimen/margin_small"
        android:background="@color/WhiteSmoke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        app:cardUseCompatPadding="true"
        app:cardCornerRadius="4dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="@dimen/margin_large"
                android:layout_marginRight="@dimen/margin_large"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_large">


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Quick Profile"
                    android:textStyle="bold"
                    android:layout_weight="3.5"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="#343434"
                    android:padding="@dimen/margin_large"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:padding="@dimen/margin_large"
                android:layout_margin="@dimen/margin_large"
                android:background="@color/ampm_text_color"/>

            <LinearLayout
                android:id="@+id/one_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="invisible"
                android:weightSum="4">
        <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/txt_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="left"

                android:layout_gravity="center"
                android:layout_margin="@dimen/margin_large"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_weight="3"/>
         <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
             app:srcCompat="@drawable/ic_prompt_unselect_line"/>
        </LinearLayout>
    <LinearLayout
            android:id="@+id/two_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:weightSum="4">
        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/txt_two"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large"
            android:text="left"
            android:layout_gravity="center"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_weight="3"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_two"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"

            app:srcCompat="@drawable/ic_prompt_unselect_line"/>
    </LinearLayout>
    <LinearLayout
            android:id="@+id/three_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:weightSum="4">
        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/txt_three"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large"
            android:text="left"
            android:layout_gravity="center"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_weight="3"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_three"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"

            app:srcCompat="@drawable/ic_prompt_unselect_line"/>
    </LinearLayout>
    <LinearLayout
            android:id="@+id/four_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:weightSum="4">
        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/txt_four"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large"
            android:text="left"
            android:layout_gravity="center"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_weight="3"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_four"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"

            app:srcCompat="@drawable/ic_prompt_unselect_line"/>
    </LinearLayout>


           <!-- <TextView
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:padding="@dimen/margin_large"
                android:background="@color/ampm_text_color"/>-->

            <LinearLayout
                android:id="@+id/redirect_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginBottom="@dimen/margin_large"
                android:layout_marginRight="@dimen/margin_large"
                android:background="@drawable/prompt_text_right_corner_purple"
                android:gravity="bottom"
                android:padding="@dimen/margin_large"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fill Details"
                    android:textStyle="italic"
                    android:textSize="@dimen/text_large"
                    android:textColor="@color/white"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"
                    />
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/margin_large"
                    android:layout_marginBottom="1dp"
                    app:srcCompat="@drawable/ic_prompt_edit_icon"/>
            </LinearLayout>


        </LinearLayout>



    </androidx.cardview.widget.CardView>

</LinearLayout>