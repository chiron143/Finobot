<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollViewId"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_alignParentTop="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/cibil_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/cibil_score_img"/>

            <android.support.v7.widget.CardView
                android:id="@+id/card_root"
                android:layout_below="@+id/cibil_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="5dp"
                android:layout_margin="@dimen/margin_medium"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <TextView
                            android:id="@+id/today_cal_title_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_xlarge"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:layout_marginLeft="@dimen/margin_medium"
                            android:layout_marginRight="@dimen/margin_medium"
                            android:textColor="@android:color/background_dark"
                            android:text="Cibil Score"
                            />
                    </RelativeLayout>

                    <View
                        android:id="@+id/view_separator_id"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/AntiqueWhite" />

                    <TextView
                        android:id="@+id/desc_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:gravity="left|center"
                        android:layout_above="@+id/more_info_id"
                        android:textStyle="normal"
                        android:layout_margin="@dimen/margin_medium"
                        android:text="A Credit Score or the Cibil Score is a three-digit numeric summary of your credit history. The score is derived using the credit history found in the Credit Information Report (CIR). A CIR is an individual’s credit payment history across loan types and credit institutions over a period of time. A CIR does not contain details of your savings, investments or fixed deposits.."/>
                </LinearLayout>
            </android.support.v7.widget.CardView>




            <android.support.v7.widget.CardView
                android:id="@+id/card_root1"
                android:layout_below="@+id/card_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="5dp"
                android:layout_margin="@dimen/margin_medium"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">


                        <TextView
                            android:id="@+id/txt_con"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_xlarge"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:layout_marginLeft="@dimen/margin_medium"
                            android:layout_marginRight="@dimen/margin_medium"
                            android:text="Would you like to know your CIBIL Score? Get yours now by visiting"/>

                        <TextView
                            android:id="@+id/cibil_link"
                         android:layout_below="@+id/txt_con"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_xlarge"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:layout_marginLeft="@dimen/margin_medium"
                            android:layout_marginRight="@dimen/margin_medium"
                            android:textColor="@color/facebook_blue_color"
                            android:text="@string/cibillink"/>
                    </RelativeLayout>



                </LinearLayout>
            </android.support.v7.widget.CardView>









        </RelativeLayout>
    </ScrollView>
    <LinearLayout

        android:id="@+id/bottom_bar_layout"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>

    </LinearLayout>
</RelativeLayout>