<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/marque_scrolling_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#efefef"
        android:ellipsize="marquee"
        android:fadingEdge="horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:freezesText="true"
        android:lines="1"

        android:marqueeRepeatLimit="marquee_forever"
        android:padding="@dimen/margin_small"
        android:scrollHorizontally="true"
        android:text=""

        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/colorAccent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/adView"
        android:layout_below="@+id/marque_scrolling_text">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <android.support.v4.view.ViewPager
                    android:id="@+id/homeViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:paddingBottom="@dimen/margin_medium">

                    <com.viewpagerindicator.CirclePageIndicator
                        android:id="@+id/indicator"
                        style="@style/CustomCirclePageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:padding="@dimen/margin_small"
                        app:fillColor="@color/colorPrimary" />
                </FrameLayout>


            </RelativeLayout>

            <ImageView
                android:id="@+id/home_page_imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/actionBarSize"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_home_finacial"
                android:visibility="gone" />


            <RelativeLayout
                android:id="@+id/card0_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                >

                <android.support.v4.view.ViewPager
                    android:id="@+id/homecard0ViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/margin_xlarge"
                    android:layout_marginBottom="@dimen/margin_xlarge"
                    android:paddingBottom="@dimen/margin_xlarge">

                    <com.viewpagerindicator.CirclePageIndicator
                        android:id="@+id/indicatorcard0"
                        style="@style/CustomCirclePageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX=".6"
                        android:scaleY=".6"
                        android:layout_marginBottom="@dimen/margin_medium"
                        app:fillColor="@color/colorPrimary"
                        android:padding="@dimen/margin_small" />
                </FrameLayout>


            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/card1_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                >

                <android.support.v4.view.ViewPager
                    android:id="@+id/homecard1ViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/margin_xlarge"
                    android:layout_marginBottom="@dimen/margin_xlarge"
                    android:paddingBottom="@dimen/margin_xlarge">

                    <com.viewpagerindicator.CirclePageIndicator
                        android:id="@+id/indicatorcard1"
                        style="@style/CustomCirclePageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX=".6"
                        android:scaleY=".6"
                        android:layout_marginBottom="@dimen/margin_medium"
                        app:fillColor="@color/colorPrimary"
                        android:padding="@dimen/margin_small" />
                </FrameLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/promptsLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                >

                <android.support.v4.view.ViewPager
                    android:id="@+id/homePromptsViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/pageIndicaterId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginRight="@dimen/margin_xlarge"
                    android:layout_marginEnd="@dimen/margin_xlarge"
                    android:layout_marginBottom="@dimen/margin_xlarge"
                    android:paddingBottom="@dimen/margin_xlarge">

                    <com.viewpagerindicator.CirclePageIndicator
                        android:id="@+id/indicatorPrompts"
                        style="@style/CustomCirclePageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:scaleX=".6"
                        android:scaleY=".6"
                        android:layout_marginBottom="@dimen/margin_medium"
                        app:fillColor="@color/colorPrimary"
                        android:padding="@dimen/margin_small" />
                </FrameLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/card2_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                >

                <android.support.v4.view.ViewPager
                    android:id="@+id/homecard2ViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/margin_xlarge"
                    android:layout_marginBottom="@dimen/margin_xlarge"
                    android:paddingBottom="@dimen/margin_xlarge">

                    <com.viewpagerindicator.CirclePageIndicator
                        android:id="@+id/indicatorcard2"
                        style="@style/CustomCirclePageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX=".6"
                        android:scaleY=".6"
                        android:layout_gravity="right"
                        android:layout_marginBottom="@dimen/margin_medium"
                        app:fillColor="@color/colorPrimary"
                        android:padding="@dimen/margin_small" />
                </FrameLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/card4_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                >

                <android.support.v4.view.ViewPager
                    android:id="@+id/homecard4ViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/margin_xlarge"
                    android:layout_marginBottom="@dimen/margin_xlarge"
                    android:paddingBottom="@dimen/margin_xlarge">

                    <com.viewpagerindicator.CirclePageIndicator
                        android:id="@+id/indicatorcard4"
                        style="@style/CustomCirclePageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX=".6"
                        android:scaleY=".6"
                        android:layout_marginBottom="@dimen/margin_medium"
                        app:fillColor="@color/colorPrimary"
                        android:padding="@dimen/margin_small" />
                </FrameLayout>


            </RelativeLayout>


            <include
                android:id="@+id/card_view_income"
                layout="@layout/view_custom_zodic_single_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/home_page_imageView"
                android:visibility="gone" />

     <!--       &lt;!&ndash;ID: ca-app-pub-6375703219723081/1304604086&ndash;&gt;
            <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/minimum_margin_sides"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_centerHorizontal="true"
                ads:adSize="BANNER"
                ads:adUnitId="ca-app-pub-2076188111537488/1179048751">
            </com.google.android.gms.ads.AdView>-->

        </LinearLayout>



    </ScrollView>

    <!--ID: ca-app-pub-6375703219723081/1304604086-->
