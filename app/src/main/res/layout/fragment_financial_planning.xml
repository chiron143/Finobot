<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_RelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <android.support.v7.widget.CardView
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_large"
        app:cardCornerRadius="5dp"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/tv_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:text="Planning"
                android:textAppearance="?android:textAppearanceLarge" />


            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/iv_center_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_goal_plans" />
            <!--android:src="@drawable/ic_goal_planning"-->

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/tv_assets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/contigencyPlanning"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginRight="@dimen/margin_xlarge"
                android:layout_toLeftOf="@+id/iv_center_image"
                android:gravity="center"
                android:text="Contingency"
                android:textAppearance="?android:textAppearanceSmall" />

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/contigencyPlanning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/iv_center_image"
                android:layout_toLeftOf="@+id/iv_center_image"
                android:scaleX="1"
                android:scaleY="1"
                app:srcCompat="@drawable/ic_contingency_planning_homepage" />

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/iv_InvestmentPlanning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_center_image"
                android:layout_toLeftOf="@+id/iv_center_image"
                android:scaleX="1"
                android:scaleY="1"
                 app:srcCompat="@drawable/ic_investment_planning_home_page" />
            <!--android:tint="@color/transparent_black"-->

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/tv_income_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_InvestmentPlanning"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_toLeftOf="@+id/iv_center_image"
                android:gravity="center"
                android:text="Investment"
                android:textAppearance="?android:textAppearanceSmall" />

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/iv_taxPlanning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_center_image"
                android:layout_toRightOf="@+id/iv_center_image"
                android:scaleX="1"
                android:scaleY="1"
                app:srcCompat="@drawable/ic_tax_planning_home_page" />

            <LinearLayout
                android:id="@+id/linear_planing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_center_image"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_marginTop="-11dp"
                android:layout_marginRight="5sp"
                android:layout_marginBottom="10dp"
                android:layout_toRightOf="@+id/iv_taxPlanning"
                android:background="@drawable/tax_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp"
                android:visibility="visible">


                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/tv_planing_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:gravity="center"
                    android:paddingLeft="4sp"
                    android:paddingRight="4sp"
                    android:text="Planning"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/tv_planing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="FY 2019- 20"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/DarkGray"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_filing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/linear_planing"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_marginRight="5sp"
                android:layout_toRightOf="@+id/iv_taxPlanning"
                android:background="@drawable/tax_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp"
                android:visibility="visible">

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/tv_filing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:gravity="center"
                    android:text="Filing"
                    android:textAppearance="?android:textAppearanceSmall"

                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/tv_filing_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="FY 2018- 19"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/DarkGray"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:visibility="visible" />

            </LinearLayout>


            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/tv_expense_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_taxPlanning"
                android:layout_centerInParent="@+id/iv_taxPlanning"
                android:layout_marginLeft="@dimen/bullet"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_toRightOf="@+id/iv_center_image"
                android:gravity="center"
                android:text="Tax"
                android:textAppearance="?android:textAppearanceSmall" />

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/iv_retirementPlanning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/iv_center_image"
                android:layout_toEndOf="@+id/iv_center_image"
                android:layout_toRightOf="@+id/iv_center_image"
                android:scaleX="1"
                android:scaleY="1"
                app:srcCompat="@drawable/ic_retirementplanning_home_page" />

            <com.purplepath.purplepath.customview.CustomTextView
                android:id="@+id/tv_retirementPlanning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_retirementPlanning"
                android:layout_marginLeft="@dimen/margin_xlarge"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_toRightOf="@+id/iv_center_image"
                android:gravity="center"
                android:text="Retirement"
                android:textAppearance="?android:textAppearanceSmall" />
        </RelativeLayout>
    </android.support.v7.widget.CardView>

</RelativeLayout>