<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cell_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:layout_gravity="center"
    android:background="@drawable/tableview_border"
    android:gravity="center"
    android:orientation="vertical">


    <com.purplepath.purplepath.customview.CustomTextView
        android:id="@+id/cell_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical|left"
        android:textColor="@color/table_view_default_text_color"
        android:textSize="@dimen/done_label_size"
        android:visibility="visible"
        tools:text="Cell Data" />

</LinearLayout>
