<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.purplepath.purplepath.AppManagement.Payment.PaymentViewPager">

    <ProgressBar
        android:id="@+id/ProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleLarge"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:indeterminateDrawable="@drawable/circle_progress"
        android:visibility="invisible"/>



    <android.support.v7.widget.CardView
        android:id="@+id/card_view1"
        android:padding="@dimen/margin_large"
        android:elevation="@dimen/margin_small"
        android:layout_margin="@dimen/margin_large"
        android:background="@color/WhiteSmoke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <android.support.design.widget.TextInputLayout
            android:id="@+id/total_amount_InputLayout"
            style="@style/StyledTilPaddedEditTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:textColorHint="@color/transparent_black"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">

            <EditText
                android:id="@+id/editTextAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/margin_xlarge"
                android:hint="Total amount"
                android:text=""
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour"
                android:textColorHint="@color/dark_gray_text_colour" />
        </android.support.design.widget.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="@dimen/margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/transparent_black"
                android:layout_margin="@dimen/margin_medium"
                android:text="Environment" />

            <Spinner
                android:id="@+id/spinner_environment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <android.support.design.widget.TextInputLayout
            android:id="@+id/cardnumber_InputLayout"
            style="@style/StyledTilPaddedEditTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:textColorHint="@color/transparent_black"
            app:hintTextAppearance="@style/StyledTilEditTextLabel">


            <EditText
                android:id="@+id/editTextMerchantKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/margin_xlarge"
                android:hint="Merchant Key"
                android:text="gtKFFx"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/dark_gray_text_colour"
                android:textColorHint="@color/dark_gray_text_colour" />
        </android.support.design.widget.TextInputLayout>




        <LinearLayout
            android:id="@+id/layout_buynow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margin_large">

            <TextView
                android:id="@+id/buy_now"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Pay Now"
                android:layout_gravity="center"
                android:gravity="center"
                android:onClick="navigateToBaseActivity"
                android:padding="@dimen/margin_xlarge"
                android:textColor="@color/white"
                android:background="@color/RoyalBlue"/>
        </LinearLayout>


    </LinearLayout>
</android.support.v7.widget.CardView>
    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>

</RelativeLayout>
