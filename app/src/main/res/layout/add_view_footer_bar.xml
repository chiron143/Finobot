<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_toRightOf="@+id/footerViewId"
        android:background="@color/colorPrimary"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/margin_medium">
    </View>

<LinearLayout
    android:id="@+id/footerViewId"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <ImageView
        android:id="@+id/backButtonId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_nav_back_icon"
        android:minHeight="25dp"
        android:minWidth="25dp"
        android:layout_gravity="center"
        android:layout_margin="@dimen/margin_medium"/>
    <ImageView
        android:id="@+id/homeButtonId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_nav_home_icon"
        android:minHeight="25dp"
        android:minWidth="25dp"
        android:layout_gravity="center"
        android:layout_margin="@dimen/margin_medium"/>
    <ImageView
        android:id="@+id/clearButtonId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:minHeight="25dp"
        android:minWidth="25dp"
        android:layout_gravity="center"/>
    <ImageView
        android:id="@+id/doneButtonId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_nav_select_icon"
        android:layout_margin="@dimen/margin_medium"
        android:minHeight="25dp"
        android:minWidth="25dp"
        android:layout_gravity="center"/>
    <ImageView
        android:id="@+id/nextButtonId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_nav_back_icon"
        android:layout_margin="@dimen/margin_medium"
        android:minHeight="25dp"
        android:minWidth="25dp"
        android:layout_gravity="center"/>

</LinearLayout>
    <View
        android:layout_toLeftOf="@+id/footerViewId"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/colorPrimary"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/margin_medium">

    </View>

</RelativeLayout>