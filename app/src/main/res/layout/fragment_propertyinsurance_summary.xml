<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No data available"
        android:textColor="@color/d_gray"
        android:textSize="@dimen/month_label_size"
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:gravity="center"/>
    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <android.support.v7.widget.CardView
                android:id="@+id/card_view"
                android:padding="@dimen/margin_large"
                android:elevation="@dimen/margin_small"
                android:layout_margin="@dimen/margin_large"
                android:background="@color/WhiteSmoke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/WhiteSmoke"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/WhiteSmoke"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txt_ownhouse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_large"
                            android:visibility="gone"
                            android:text="OWN" />
                        <TextView
                            android:id="@+id/txt_rent_house"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_large"
                            android:visibility="gone"
                            android:text="rent" />
                    </LinearLayout>


                </LinearLayout>
            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:id="@+id/card_own_house"
                android:layout_below="@+id/card_view"
                android:padding="@dimen/margin_large"
                android:elevation="@dimen/margin_small"
                android:layout_margin="@dimen/margin_small"
                android:background="@color/WhiteSmoke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/WhiteSmoke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/WhiteSmoke"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/own_house"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            style="?android:textAppearanceMedium"
                            android:text="Own House"
                            android:layout_margin="@dimen/margin_small"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:weightSum="5">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/layout_house_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7"
                        android:layout_margin="@dimen/margin_large">



                            <com.purplepath.purplepath.customview.CustomTextView
                                android:id="@+id/txt_house"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/margin_small"
                                android:layout_weight="4"
                                android:text="House Value"
                                />
                            <com.purplepath.purplepath.customview.DefaultCurrencyTextView
                                android:id="@+id/house_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:layout_margin="@dimen/margin_small"
                                android:maxLines="1"
                                android:text="4623463567"
                                />

                    </LinearLayout>



                    <LinearLayout
                        android:id="@+id/layout_house_content_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_margin="@dimen/margin_large"
                        android:weightSum="7">


                            <com.purplepath.purplepath.customview.CustomTextView
                                android:id="@+id/txt_house_content"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="4"
                                android:layout_margin="@dimen/margin_small"
                                android:text="Content Value" />

                            <com.purplepath.purplepath.customview.DefaultCurrencyTextView
                                android:id="@+id/house_content_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:layout_margin="@dimen/margin_small"
                                android:maxLines="1"
                                android:text="563457"/>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/layout_house_insurance_coverage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7"
                        android:layout_margin="@dimen/margin_large" >

                            <com.purplepath.purplepath.customview.CustomTextView
                                android:id="@+id/txt_house_insurance_coverage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="4"
                                android:layout_margin="@dimen/margin_small"
                                android:text="Insurance Coverage"
                                android:maxLines="1"
                                />

                            <com.purplepath.purplepath.customview.DefaultCurrencyTextView
                                android:id="@+id/house_insurance_coverage_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:layout_margin="@dimen/margin_small"
                                android:maxLines="1"
                                android:text="342634345"/>

                    </LinearLayout>
                </LinearLayout>
            </android.support.v7.widget.CardView>


            <android.support.v7.widget.CardView
                android:id="@+id/card_rent_house"
                android:layout_below="@+id/card_own_house"
                android:padding="@dimen/margin_large"
                android:elevation="@dimen/margin_small"
                android:layout_margin="@dimen/margin_small"
                android:background="@color/WhiteSmoke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/WhiteSmoke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/WhiteSmoke"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/rent_house"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            style="?android:textAppearanceMedium"
                            android:text="Rent House"
                            android:layout_margin="@dimen/margin_small"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:weightSum="5">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray"/>
                    </LinearLayout>




                    <LinearLayout
                        android:id="@+id/layout_rent_content_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_margin="@dimen/margin_large"
                        android:weightSum="7">


                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/txt_rent_content"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:layout_margin="@dimen/margin_small"
                            android:text="Content Value" />

                        <com.purplepath.purplepath.customview.DefaultCurrencyTextView
                            android:id="@+id/rent_content_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:layout_margin="@dimen/margin_small"
                            android:maxLines="1"
                            android:text="563457"/>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/layout_rent_insurance_coverage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7"
                        android:layout_margin="@dimen/margin_large" >

                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/txt_rent_insurance_coverage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:layout_margin="@dimen/margin_small"
                            android:text="Insurance Coverage"
                            android:maxLines="1"
                            />

                        <com.purplepath.purplepath.customview.DefaultCurrencyTextView
                            android:id="@+id/rent_insurance_coverage_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:layout_margin="@dimen/margin_small"
                            android:maxLines="1"
                            android:text="100000"/>

                    </LinearLayout>
                </LinearLayout>
            </android.support.v7.widget.CardView>







        </RelativeLayout>
    </ScrollView>



    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>
</RelativeLayout>
