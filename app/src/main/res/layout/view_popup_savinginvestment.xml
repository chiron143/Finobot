<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/white">
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/colorPrimary" />

    <RelativeLayout
        android:layout_below="@+id/title"
        android:layout_above="@+id/bottom_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

            <TextView
                android:id="@+id/empty_values"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="No data to retrieve"
                android:visibility="gone"
                android:textColor="@color/d_gray"
                android:textSize="@dimen/month_label_size"
                android:layout_gravity="center_horizontal"
                android:layout_centerInParent="true"
                android:gravity="center"/>


                <RelativeLayout
                    android:id="@+id/tableParentView_saving_investment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                </RelativeLayout>





        </RelativeLayout>






    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>
    </LinearLayout>
</RelativeLayout>