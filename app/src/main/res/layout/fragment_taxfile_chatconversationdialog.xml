<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/frame_layout_clickall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dialogbg">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_vertical"
                    android:text="Redo"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_xxlarge"
                    android:src="@drawable/ic_up_hand_guide"/>


            </LinearLayout>

            <RelativeLayout
                android:id="@+id/gotlayout_click"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end">


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/got_hand"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:src="@drawable/got_arrows"
                    />
            </RelativeLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:minWidth="@dimen/activity_horizontal_margin"
                android:background="@drawable/prompt_text_corner">

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/txt_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_xlarge"
                    android:minWidth="@dimen/activity_horizontal_margin"
                    android:textColor="#343434"
                    android:text="First Name"
                    android:layout_gravity="center"
                    android:textAppearance="?android:attr/textAppearanceLarge"/>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"  >
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/framecardimageview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_up_hand_guide"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/framecardimageview"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_centerInParent="true"
                    android:text="Questions we ask"/>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right">
                <LinearLayout
                    android:id="@+id/layout_anim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:background="@drawable/prompt_right_corner"
                    android:layout_margin="@dimen/margin_large">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:id="@+id/txt_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|center"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:gravity="right|center"
                        android:layout_alignParentRight="true"
                        android:text="Arun"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="#343434" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_edit_profile"/>

                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end">
                <TextView
                    android:id="@+id/right_card_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_vertical"
                    android:text="Edit your answer"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/right_cardview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_up_hand_guide"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_large"
                android:minWidth="@dimen/activity_horizontal_margin"
                android:background="@drawable/prompt_text_corner">

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/txt_left_second"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_xlarge"
                    android:minWidth="@dimen/activity_horizontal_margin"
                    android:textColor="#343434"
                    android:text="Middle Name"
                    android:layout_gravity="center"
                    android:textAppearance="?android:attr/textAppearanceLarge"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:background="@drawable/prompt_right_corner"
                    android:layout_margin="@dimen/margin_large">

                    <com.purplepath.purplepath.customview.CustomTextView
                        android:id="@+id/txt_right_second"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|center"
                        android:layout_margin="@dimen/margin_xlarge"
                        android:gravity="right|center"
                        android:layout_alignParentRight="true"
                        android:text="Ramaswamy"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="#343434" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_edit_profile"/>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>



        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">
            <LinearLayout
                android:id="@+id/layout_character_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="5"
                android:orientation="horizontal">

                <com.purplepath.purplepath.customview.CustomTextInputLayout
                    android:id="@+id/Character_InputLayout"
                    android:layout_width="0dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:hint="A"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="5"
                    app:hintTextAppearance="@style/StyledTilEditTextFloatingLabel">
                    <com.purplepath.purplepath.customview.CharacterEditText
                        android:id="@+id/character_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:hint="Arun"
                        android:focusable="false"
                        android:maxLines="1"
                        android:textSize="@dimen/day_number_size"
                        android:inputType="none"
                        android:background="@drawable/edittextbackgroundpurple"
                        android:windowSoftInputMode="stateVisible|adjustResize"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white" />
                </com.purplepath.purplepath.customview.CustomTextInputLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/character_edittext_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    app:fab_size="mini"
                    android:layout_margin="@dimen/margin_large"
                    app:srcCompat="@drawable/ic_send_icon"/>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="50dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginLeft="@dimen/margin_xxlarge"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="@dimen/margin_xxlarge"
                    app:srcCompat="@drawable/down_twoarrows"
                    />

            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="110dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enter your values in this text field"
                    android:textColor="@color/white"
                    android:gravity="center"/>

            </LinearLayout>
        </FrameLayout>


    </FrameLayout>

</LinearLayout>