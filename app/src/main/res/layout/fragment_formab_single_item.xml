<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">


        <RelativeLayout
            android:id="@+id/relativelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large">


            <RelativeLayout
                android:id="@+id/layout_document"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/document_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_large"
                    app:srcCompat="@drawable/ic_link_dummy"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/document_name"
                    android:layout_toRightOf="@+id/document_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="form16.pdf"
                    android:layout_centerVertical="true"
                    android:layout_margin="@dimen/margin_large"
                    android:maxLines="2"
                    android:layout_marginLeft="@dimen/bullet"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textStyle="normal"/>

                <TextView
                    android:id="@+id/view_details"
                    android:layout_below="@+id/document_name"
                    android:layout_alignParentRight="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form16_viewmore"
                    android:textColor="@color/hint_color"
                    android:layout_margin="@dimen/margin_large"
                    android:layout_marginLeft="@dimen/bullet"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textStyle="normal"/>

            </RelativeLayout>


        </RelativeLayout>
</RelativeLayout>