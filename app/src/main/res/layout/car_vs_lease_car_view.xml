<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.purplepath.purplepath.customview.CurrencyGhostView
            android:id="@+id/car_purchase_price_edt_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint=""
            android:layout_margin="@dimen/margin_medium"
            android:layout_weight="1.7"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:layout_marginLeft="@dimen/margin_medium"
            android:layout_marginRight="@dimen/margin_medium"
            android:textAppearance="?android:textAppearanceSmall"/>

        <com.purplepath.purplepath.customview.CustomCalenderImageView
            android:id="@+id/car_purchase_price_cal_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.3"
            android:drawablePadding="@dimen/margin_xlarge" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_xlarge"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:paddingLeft="@dimen/margin_large"
        android:paddingRight="@dimen/margin_medium"
        android:orientation="horizontal"
        >


        <com.purplepath.purplepath.customview.CustomTextView
            android:id="@+id/family_details_gender_Txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/margin_medium"
            android:layout_marginLeft="@dimen/margin_xlarge"
            android:layout_marginRight="@dimen/margin_large"
            android:text="@string/loanRequired"
            android:textAppearance="?android:attr/textAppearanceSmall"
            />

        <RadioGroup
            android:id="@+id/loanReq_RadioRg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/margin_medium"
            android:background="@drawable/switch_border"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/loanReq_yes_RadioBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/switch_no"
                android:button="@null"
                android:gravity="center"
                android:padding="@dimen/margin_medium"
                android:text="@string/radio_yes" />


            <RadioButton
                android:id="@+id/loanReq_no_RadioBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/swithc_yes"
                android:button="@null"
                android:gravity="center"
                android:padding="@dimen/margin_medium"
                android:text="@string/radio_no" />
        </RadioGroup>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/loanViewLayoutId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        >

        <com.purplepath.purplepath.customview.CurrencyGhostView
            android:id="@+id/downpayment_edt_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint=""
            android:layout_margin="@dimen/margin_medium"
            android:layout_weight="1.7"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:layout_marginLeft="@dimen/margin_medium"
            android:layout_marginRight="@dimen/margin_medium"
            android:textAppearance="?android:textAppearanceSmall"/>

        <com.purplepath.purplepath.customview.CustomCalenderImageView
            android:id="@+id/downpayment_edt_cal_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.3"
            android:drawablePadding="@dimen/margin_xlarge" />

    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/loanamount_edt_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint=""
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1.7"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginLeft="@dimen/margin_medium"
                android:layout_marginRight="@dimen/margin_medium"
                android:textAppearance="?android:textAppearanceSmall"/>

            <com.purplepath.purplepath.customview.CustomCalenderImageView
                android:id="@+id/loanamount_edt_cal_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.3"
                android:drawablePadding="@dimen/margin_xlarge" />

        </LinearLayout>
        <com.purplepath.purplepath.customview.CustomTextInputLayout
            android:id="@+id/loan_tenurelayoutId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:textColorHint="@color/dark_gray_text_colour"
            app:hintTextAppearance="@style/StyledTilEditTextFloatingLabel">

        <com.purplepath.purplepath.customview.NumberEditText
            android:id="@+id/loan_tenure_id"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
            android:hint="@string/loantenureMonth"
           />
        </com.purplepath.purplepath.customview.CustomTextInputLayout>
        <com.purplepath.purplepath.customview.CustomTextInputLayout
            android:id="@+id/loan_interestlayoutId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:textColorHint="@color/dark_gray_text_colour"
            app:hintTextAppearance="@style/StyledTilEditTextFloatingLabel">

            <com.purplepath.purplepath.customview.PercentageEditText
                android:id="@+id/loan_interest_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/loaninterestrate"
                />
        </com.purplepath.purplepath.customview.CustomTextInputLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:visibility="gone">

            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/eset_car_value_at_end_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/discount"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1.7"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginLeft="@dimen/margin_medium"
                android:layout_marginRight="@dimen/margin_medium"
                android:textAppearance="?android:textAppearanceSmall"/>

            <com.purplepath.purplepath.customview.CustomCalenderImageView
                android:id="@+id/eset_car_value_at_end_cal_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.3"
                android:drawablePadding="@dimen/margin_xlarge" />

        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">


                <com.purplepath.purplepath.customview.CurrencyGhostView
                    android:id="@+id/rebates_edit_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/rebates"
                    android:imeOptions="actionNext"
                    android:layout_toLeftOf="@+id/rebates_calculatorimage"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textAppearance="?android:attr/textAppearanceSmall" />


            <com.purplepath.purplepath.customview.CustomCalenderImageView
                android:id="@+id/rebates_calculatorimage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_toLeftOf="@+id/rebates_rg"
                android:padding="@dimen/margin_medium" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/rebatesPercent_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginLeft="@dimen/margin_large"
                android:layout_marginRight="@dimen/margin_large"
                android:layout_marginStart="@dimen/margin_large"
                android:layout_toLeftOf="@+id/rebates_rg"
                android:visibility="gone"
                app:errorEnabled="true"
                app:hintTextAppearance="@style/StyledTilEditTextLabel">

                <com.purplepath.purplepath.customview.PercentageEditText
                    android:id="@+id/edt_rebatesPercent_view_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Processing Fees"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </android.support.design.widget.TextInputLayout>


            <RadioGroup
                android:id="@+id/rebates_rg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_alignParentRight="true"
                android:layout_marginRight="@dimen/margin_small"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/margin_large"
                android:background="@drawable/switch_border"
                android:checkedButton="@+id/processingFee_rupeee_RadioBtn"
                android:orientation="horizontal"
                android:scaleX="0.5"
                android:scaleY="0.5">

                <RadioButton
                    android:id="@+id/rebates_rupeee_RadioBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/switch_no"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/margin_medium"
                    android:text="@string/Rupee_symbol"
                    android:textAppearance="?android:textAppearanceLarge"
                    android:textColor="@color/gray" />

                <RadioButton
                    android:id="@+id/rebates_percent_RadioBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/swithc_yes"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/margin_medium"
                    android:text="@string/Percent_symbol"
                    android:textAppearance="?android:textAppearanceLarge"
                    android:textColor="@color/gray" />
            </RadioGroup>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">


            <com.purplepath.purplepath.customview.CurrencyGhostView
                android:id="@+id/trade_in_edit_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/rebates"
                android:imeOptions="actionNext"
                android:layout_toLeftOf="@+id/trade_in_calculatorimage"
                android:inputType="number"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall" />


            <com.purplepath.purplepath.customview.CustomCalenderImageView
                android:id="@+id/trade_in_calculatorimage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_toLeftOf="@+id/trade_in_rg"
                android:padding="@dimen/margin_medium" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/trade_in_Percent_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginLeft="@dimen/margin_large"
                android:layout_marginRight="@dimen/margin_large"
                android:layout_marginStart="@dimen/margin_large"
                android:layout_toLeftOf="@+id/trade_in_rg"
                android:visibility="gone"
                app:errorEnabled="true"
                app:hintTextAppearance="@style/StyledTilEditTextLabel">

                <com.purplepath.purplepath.customview.PercentageEditText
                    android:id="@+id/edt_trade_inPercent_view_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Processing Fees"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </android.support.design.widget.TextInputLayout>


            <RadioGroup
                android:id="@+id/trade_in_rg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_alignParentRight="true"
                android:layout_marginRight="@dimen/margin_small"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/margin_large"
                android:background="@drawable/switch_border"
                android:checkedButton="@+id/processingFee_rupeee_RadioBtn"
                android:orientation="horizontal"
                android:scaleX="0.5"
                android:scaleY="0.5">

                <RadioButton
                    android:id="@+id/trade_in_rupeee_RadioBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/switch_no"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/margin_medium"
                    android:text="@string/Rupee_symbol"
                    android:textAppearance="?android:textAppearanceLarge"
                    android:textColor="@color/gray" />

                <RadioButton
                    android:id="@+id/trade_in_percent_RadioBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/swithc_yes"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/margin_medium"
                    android:text="@string/Percent_symbol"
                    android:textAppearance="?android:textAppearanceLarge"
                    android:textColor="@color/gray" />
            </RadioGroup>
        </RelativeLayout>


    </LinearLayout>
</LinearLayout>
</ScrollView>