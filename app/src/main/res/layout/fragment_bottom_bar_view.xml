<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"

    android:weightSum="3">

    <RelativeLayout
        android:id="@+id/relative_left_arrow"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_height_dimen"
        android:layout_marginRight="@dimen/margin_very_small"
        android:layout_weight="1"
        android:background="@color/colorPrimary"
        android:gravity="center">

        <android.support.v7.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/bottom_back_icon" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_center_home"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_height_dimen"
        android:layout_marginRight="@dimen/margin_very_small"
        android:layout_weight="1"
        android:background="@color/colorPrimary"
        android:gravity="center">

        <android.support.v7.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/bottom_home_icon" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_right_arrow"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_height_dimen"
        android:layout_weight="1"
        android:background="@color/colorPrimary"
        android:gravity="center">

        <android.support.v7.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/bottom_next_arrow" />

    </RelativeLayout>

</LinearLayout>