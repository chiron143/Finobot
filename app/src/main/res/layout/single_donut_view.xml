<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

    <android.support.v7.widget.CardView
        android:id="@+id/donutlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:background="@color/WhiteSmoke"
        android:elevation="@dimen/margin_small">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/titlelinelayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/WhiteSmoke"
                android:padding="@dimen/margin_large">

                <android.support.v7.widget.AppCompatImageView
                    android:id="@+id/link_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/ic_goal_timeline" />

                <com.purplepath.purplepath.customview.CustomTextView
                    android:id="@+id/title"
                    style="?android:textAppearanceMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/bullet"
                    android:layout_toRightOf="@+id/link_image"
                    android:text="Surya Education 2017"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textStyle="bold" />
            </RelativeLayout>
            <android.support.v7.widget.CardView
                android:id="@+id/card_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:background="@color/WhiteSmoke"
                android:visibility="visible"
                android:elevation="@dimen/margin_small">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/layout_charitycon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:weightSum="5">

                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/headingText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Years to Goal "
                            android:layout_margin="@dimen/margin_large"
                            android:gravity="left"
                            android:layout_weight="3"
                            android:layout_marginLeft="@dimen/margin_xlarge"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textStyle="bold"
                            />

                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/goal_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_margin="@dimen/margin_large"
                            android:maxLines="1"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/layout_retirement_need"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:visibility="gone"
                        android:weightSum="5">

                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/retirement_need_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Expected Amount"
                            android:layout_margin="@dimen/margin_large"
                            android:gravity="left"
                            android:layout_marginLeft="@dimen/margin_xlarge"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textStyle="bold"
                            />

                        <com.purplepath.purplepath.customview.CurrencyTextView
                            android:id="@+id/retirement_need_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_margin="@dimen/margin_large"
                            android:maxLines="1"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_expected_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:weightSum="5">

                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/expected_amount_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Expected Amount"
                            android:layout_margin="@dimen/margin_large"
                            android:gravity="left"
                            android:layout_marginLeft="@dimen/margin_xlarge"
                            android:layout_weight="3"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textStyle="bold"
                            />

                        <com.purplepath.purplepath.customview.CurrencyTextView
                            android:id="@+id/expected_amount_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_margin="@dimen/margin_large"
                            android:maxLines="1"

                            />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_required"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:weightSum="5">

                        <com.purplepath.purplepath.customview.CustomTextView
                            android:id="@+id/required_amount_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Required Amount"
                            android:layout_margin="@dimen/margin_large"
                            android:gravity="left"
                            android:layout_weight="3"
                            android:layout_marginLeft="@dimen/margin_xlarge"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textStyle="bold"
                            />

                        <com.purplepath.purplepath.customview.CurrencyTextView
                            android:id="@+id/required_amount_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_margin="@dimen/margin_large"
                            android:maxLines="1"

                            />
                    </LinearLayout>
                </LinearLayout>

            </android.support.v7.widget.CardView>

            <TextView
                android:id="@+id/thicklineview"
                android:layout_width="wrap_content"
                android:layout_height="1dp"
                android:layout_below="@+id/titlelinelayout" />



            <LinearLayout
                android:id="@+id/addViewsinglegoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@+id/thicklineview"
                android:layout_margin="@dimen/margin_medium"
                android:background="@drawable/rectangle_border_bg"
                />


        </LinearLayout>

    </android.support.v7.widget.CardView>


            <Space
                android:layout_width="match_parent"
                android:layout_height="100dp" />
            </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/fragment_bottom_tool_bar"/>

    </LinearLayout>
</RelativeLayout>
