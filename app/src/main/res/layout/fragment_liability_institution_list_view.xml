<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false">

    <RelativeLayout
        android:id="@+id/add_button_parent_layout"
        android:visibility="gone"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/goal_header_bg_relativelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/goal_bottom_bg_imageView"
                android:layout_gravity="center"
              android:layout_centerInParent="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/empty_logo"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/goal_plus_btn_framelayout"
            android:layout_below="@+id/goal_header_bg_relativelayout"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <!--<ImageView-->
            <!--android:id="@+id/goal_plus_bg_imageView"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:src="@drawable/goal_plus_bg"/>-->

            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/preretirementAddBtnId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_add_icon_big"
                android:visibility="gone"/>
        </FrameLayout>

        <TextView
            android:id="@+id/goal_headear_bg_TxtView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/dark_gray_text_colour"
            android:textSize="@dimen/day_number_size"
            android:text="Please add institution by clicking the + button"
            android:layout_below="@+id/goal_plus_btn_framelayout"
            android:layout_centerHorizontal="true" />
        <!--<Button-->
            <!--android:id="@+id/preretirementAddBtnId"-->
            <!--android:layout_width="wrap_content"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:layout_centerInParent="true"-->
            <!--android:text="Add"-->
            <!--android:visibility="gone"-->
            <!--android:textColor="@android:color/white"-->
            <!--android:background="@drawable/btn_bg"/> />-->

    </RelativeLayout>
    <ScrollView
        android:id="@+id/libi_parent_listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
       >
    <LinearLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/liability__layout"
            android:layout_toLeftOf="@+id/liability__edit_layout"
            android:weightSum="3"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/liability__name"
                android:layout_weight="1"
                android:layout_margin="@dimen/margin_large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:gravity="center"
                android:text="Name"/>

            <TextView
                android:id="@+id/liability__type_header"
                android:layout_weight="1"
                android:layout_margin="@dimen/margin_large"
                android:padding="@dimen/margin_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:gravity="center"
                android:text="Type"/>


            <TextView
                android:id="@+id/liability__currentvalue"
                android:layout_weight="1"
                android:layout_margin="@dimen/margin_large"
                android:padding="@dimen/margin_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:gravity="center"
                android:text="Loan amount"/>


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/liability__edit_layout"
            android:layout_alignParentRight="true"
           android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <android.support.v7.widget.AppCompatImageView
                    android:id="@+id/liability__edit_rowitem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_pop_up"/>


                <android.support.v7.widget.AppCompatImageView
                    android:id="@+id/liability__delete_rowitem"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_delet_icon"/>
            </LinearLayout>
        </RelativeLayout>
        </RelativeLayout>

        <com.purplepath.purplepath.customview.ExpandableListView
            android:id="@+id/Institution_liability_list"
            android:layout_below="@+id/liability__layout"
            android:divider="@null"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        </com.purplepath.purplepath.customview.ExpandableListView>


<!--
        <LinearLayout
            android:id="@+id/liability_add_layout"
            android:layout_below="@+id/Institution_liability_list"
            android:orientation="horizontal"
            android:layout_marginBottom="?android:attr/actionBarSize"
            android:gravity="center"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/purple_path_app_orange"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Add Liabilities"/>


            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/liability_add_imageView"
                android:layout_margin="@dimen/margin_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_add_icon_select"/>
        </LinearLayout>
-->
        <Space
            android:layout_width="match_parent"
            android:layout_height="150dp" />

    </LinearLayout>
    </ScrollView>
    <android.support.design.widget.FloatingActionButton
        android:id="@+id/liability__fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom|end"
        android:layout_marginLeft="@dimen/fab_margin"
        android:layout_marginRight="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/filter_image"
        android:background="@color/colorPrimary"
        android:scaleType="fitXY"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_pls_icon"
        android:visibility="visible"  />
</RelativeLayout>